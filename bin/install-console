#!/usr/bin/env bash
# Installs or upgrades the console in production (INSTALL.md). Safe to run again: it never overwrites a value of
# prod.env, only fills the empty secrets, and realigns the database roles with prod.env on every run (the roles are
# created by roles.sh only on a fresh volume, so a volume older than prod.env would otherwise refuse the passwords).
# It checks the host but installs nothing on it: a missing tool is reported with the command to install it.
#
# The image is never built on the server by default: the release workflow publishes it signed on GHCR
# (ghcr.io/dependencyverifier/console:latest). This script verifies the cosign signature of :latest, pulls that very
# digest, starts it with --pull never and proves the containers run it, then migrates. --build builds it locally.
set -Eeuo pipefail

usage() {
    cat <<'EOF'
Usage: bin/install-console [--check] [--build] [--allow-downgrade] [--super-admin <email>]

  --check                 check the host prerequisites only, change nothing (with --build: those of a local build)
  --build                 build the image on this server instead of pulling the signed release (about 1 GB of memory)
  --allow-downgrade       accept a published version lower than the one in service
  --super-admin <email>   create a super admin at the end (password typed hidden, needs a terminal)
  -h, --help              show this help

Run it from the root of the repository. On the first run it creates prod.env from prod.env.dist and stops: fill
SERVER_NAME, DEFAULT_URI, MAILER_DSN and MAILER_FROM, then run it again. The secrets left empty are generated.
EOF
}

CHECK_ONLY=0
BUILD=0
ALLOW_DOWNGRADE=0
SUPER_ADMIN_EMAIL=''
while [ $# -gt 0 ]; do
    case "$1" in
        --check) CHECK_ONLY=1 ;;
        --build) BUILD=1 ;;
        --allow-downgrade) ALLOW_DOWNGRADE=1 ;;
        --super-admin)
            [ $# -ge 2 ] || { usage >&2; exit 2; }
            SUPER_ADMIN_EMAIL="$2"
            shift
            ;;
        -h | --help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

# shellcheck source=bin/lib/release.sh
. "$(dirname "$0")/lib/release.sh"

PROD_ENV=prod.env
OWNER_ENV=.docker/database/owner.env
# cosign 3.1.4, pinned by digest, run in a container: nothing to install on the host.
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign@sha256:0f06154836d2de34f887a5c273506d52ca43edaa1d9e53e6510fa78a48f69c2d
# The image the console containers start: set by the acquisition (acquire_verified_image or acquire_built_image).
IMAGE_REF=''
MIN_COMPOSE_VERSION=2.24.0
MIN_FREE_DISK_KB=$((5 * 1024 * 1024))
# Building the images: `yarn install` of the front assets alone is killed below about 900 MB (measured), and the PHP
# vendors build at the same time. Under 1 GB of available memory (RAM + free swap) the build ends with exit code 137.
MIN_BUILD_MEMORY_KB=$((1024 * 1024))
RECOMMENDED_RAM_KB=$((2 * 1024 * 1024))

if [ -t 1 ]; then
    BOLD=$'\033[1m' RED=$'\033[31m' YELLOW=$'\033[33m' GREEN=$'\033[32m' RESET=$'\033[0m'
else
    BOLD='' RED='' YELLOW='' GREEN='' RESET=''
fi

STEP='startup'
step() { STEP="$1"; printf '\n%s==> %s%s\n' "$BOLD" "$1" "$RESET"; }
ok() { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$1"; }
fail() { printf '  %s✗%s %s\n' "$RED" "$RESET" "$1"; }
die() { printf '\n%sError:%s %s\n' "$RED" "$RESET" "$1" >&2; exit 1; }

on_error() {
    # set -E hands the trap to command substitutions: a probe failing there is expected, report the main shell only.
    [ "$BASH_SUBSHELL" -eq 0 ] || return 0
    printf '\n%sFailed during: %s%s\n' "$RED" "$STEP" "$RESET" >&2
    printf 'Diagnose with: docker compose ps; docker compose logs --tail=100 <service> (php, worker, cron, database)\n' >&2
}
trap on_error ERR

# Value of KEY in an env file, without surrounding quotes; empty when the key is absent.
env_get() {
    local value
    value=$(grep -E "^$1=" "$2" | tail -n 1 | cut -d= -f2-) || true
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    printf '%s' "$value"
}

# Sets KEY=VALUE in an env file (the line is replaced, or appended when absent), keeping its mode.
env_set() {
    local tmp
    tmp=$(mktemp "$3.XXXXXX")
    KEY="$1" VALUE="$2" awk '
        BEGIN { key = ENVIRON["KEY"]; value = ENVIRON["VALUE"]; done = 0 }
        index($0, key "=") == 1 { print key "=" value; done = 1; next }
        { print }
        END { if (!done) print key "=" value }
    ' "$3" > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$3"
}

# ---------------------------------------------------------------------------------------------------------------------
check_prerequisites() {
    step 'Checking the host'
    local errors=0

    if [ -f compose.prod.yaml ] && [ -f prod.env.dist ] && [ -f Makefile ]; then
        ok 'run from the root of the repository'
    else
        fail 'run this script from the root of the console repository (cd console; bin/install-console)'
        errors=$((errors + 1))
    fi

    local tool hint
    for tool in docker make git openssl awk; do
        case "$tool" in
            docker) hint='https://docs.docker.com/engine/install/ (Docker Engine and the Compose plugin)' ;;
            make) hint='apt-get install make' ;;
            git) hint='apt-get install git' ;;
            openssl) hint='apt-get install openssl' ;;
            awk) hint='apt-get install gawk' ;;
        esac
        if command -v "$tool" > /dev/null 2>&1; then
            ok "$tool"
        else
            fail "$tool is missing: $hint"
            errors=$((errors + 1))
        fi
    done

    if command -v docker > /dev/null 2>&1; then
        if docker info > /dev/null 2>&1; then
            ok 'Docker daemon reachable'
        else
            fail 'the Docker daemon is not reachable: start it (systemctl start docker) or add this user to the docker group'
            errors=$((errors + 1))
        fi

        local compose_version
        if compose_version=$(docker compose version --short 2> /dev/null); then
            compose_version="${compose_version#v}"
            if ! version_lt "$compose_version" "$MIN_COMPOSE_VERSION"; then
                ok "Docker Compose $compose_version"
            else
                fail "Docker Compose $compose_version is too old, $MIN_COMPOSE_VERSION or later is needed: apt-get install docker-compose-plugin"
                errors=$((errors + 1))
            fi
        else
            fail 'the Docker Compose plugin is missing (docker compose): apt-get install docker-compose-plugin'
            errors=$((errors + 1))
        fi
    fi

    # Ports 80/443: free, or already held by this project's own php container (upgrade).
    if docker compose ps --status running --quiet php 2> /dev/null | grep -q .; then
        ok 'ports 80/443 held by the running console'
    elif command -v ss > /dev/null 2>&1; then
        local port
        for port in 80 443; do
            if ss -ltnH "sport = :$port" 2> /dev/null | grep -q .; then
                fail "port $port is already used by another program (ss -ltnp 'sport = :$port')"
                errors=$((errors + 1))
            else
                ok "port $port free"
            fi
        done
    else
        warn 'ss not found: ports 80/443 not checked'
    fi

    check_run_memory
    if [ "$BUILD" -eq 1 ]; then
        check_build_memory || errors=$((errors + 1))
    fi

    local free_kb
    free_kb=$(df -Pk . | awk 'NR == 2 { print $4 }')
    if [ "${free_kb:-0}" -lt "$MIN_FREE_DISK_KB" ]; then
        warn "less than 5 GB free on this disk ($((free_kb / 1024)) MB): the images and the database need room"
    else
        ok 'disk space'
    fi

    if command -v git > /dev/null 2>&1 && [ -d .git ]; then
        local tag
        if tag=$(checkout_tag); then
            ok "release $tag"
        else
            warn 'the checkout is not on a release tag (git checkout v1.x.y): a branch is not meant for production'
        fi
    fi

    if [ -f "$PROD_ENV" ]; then
        check_public_address
    fi

    [ "$errors" -eq 0 ] || die "$errors prerequisite(s) missing, see above."
}

# The release tag of the checkout (vX.Y.Z), or nothing (a branch, another tag).
checkout_tag() {
    local tag
    tag=$(git describe --exact-match --tags 2> /dev/null) || return 1
    is_release_tag "$tag" || return 1
    printf '%s' "$tag"
}

# Memory to run the console (PostgreSQL, FrankenPHP and the worker): a warning only.
check_run_memory() {
    [ -r /proc/meminfo ] || { warn '/proc/meminfo unreadable: memory not checked'; return 0; }
    local total
    total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
    if [ "${total:-0}" -lt "$RECOMMENDED_RAM_KB" ]; then
        warn "$((total / 1024)) MB of RAM: 1 GB runs the console, 2 GB are recommended"
    else
        ok 'memory'
    fi
}

# Memory to build the image (--build only): available RAM + free swap, what the running containers leave.
check_build_memory() {
    [ -r /proc/meminfo ] || { warn '/proc/meminfo unreadable: memory for the build not checked'; return 0; }
    local available swap_free usable
    available=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
    swap_free=$(awk '/^SwapFree:/ { print $2 }' /proc/meminfo)
    usable=$(( ${available:-0} + ${swap_free:-0} ))
    if [ "$usable" -lt "$MIN_BUILD_MEMORY_KB" ]; then
        fail "only $((usable / 1024)) MB of memory available (RAM + free swap): building the image needs about 1 GB,"
        fail 'or the build is killed (exit code 137). Run without --build to pull the published image instead, or free'
        fail 'some memory during the build: docker compose stop worker cron, then run this script again'
        return 1
    fi
    ok 'memory for the build'
}

# SERVER_NAME is a host name (Caddy terminates TLS and gets its certificate) or only a port such as ":80" (a reverse
# proxy in front terminates TLS, INSTALL.md "Behind a reverse proxy"): only a host name has a DNS record to check.
check_public_address() {
    local server_name host
    server_name=$(env_get SERVER_NAME "$PROD_ENV")
    [ -n "$server_name" ] || return 0
    host="${server_name%%,*}"
    host="${host// /}"
    host="${host#*://}"
    host="${host%%:*}"

    if [ -z "$host" ]; then
        ok "SERVER_NAME=$server_name: TLS terminated by the reverse proxy in front"
        [ -n "$(env_get SYMFONY_TRUSTED_PROXIES "$PROD_ENV")" ] \
            || warn 'SYMFONY_TRUSTED_PROXIES is empty: set the address of the reverse proxy, or every client gets its IP (rate limits, audit log) and the console believes it is served over http'
        [[ "$(env_get DEFAULT_URI "$PROD_ENV")" == https://* ]] \
            || warn 'DEFAULT_URI should be the public https:// address served by the reverse proxy'
        return 0
    fi

    if command -v getent > /dev/null 2>&1 && ! getent hosts "$host" > /dev/null 2>&1; then
        warn "$host does not resolve: Caddy cannot get its certificate until the DNS points to this server"
    fi
}

# ---------------------------------------------------------------------------------------------------------------------
prepare_prod_env() {
    step "Settings ($PROD_ENV)"

    if [ ! -f "$PROD_ENV" ]; then
        (umask 077; cp prod.env.dist "$PROD_ENV")
        chmod 600 "$PROD_ENV"
        ok "$PROD_ENV created from prod.env.dist"
        printf '\nFill SERVER_NAME, DEFAULT_URI, MAILER_DSN and MAILER_FROM in %s, then run bin/install-console again.\n' "$PROD_ENV"
        printf 'The secrets left empty are generated by the script.\n'
        exit 0
    fi
    chmod 600 "$PROD_ENV"

    local missing=() key value
    for key in SERVER_NAME DEFAULT_URI MAILER_DSN MAILER_FROM; do
        value=$(env_get "$key" "$PROD_ENV")
        if [ -z "$value" ] || [[ "$value" == *example.com* ]]; then
            missing+=("$key")
        fi
    done
    [ "$(env_get COMPOSE_FILE "$PROD_ENV")" = 'compose.yaml:compose.prod.yaml' ] || missing+=('COMPOSE_FILE (compose.yaml:compose.prod.yaml)')
    [ ${#missing[@]} -eq 0 ] || die "fill these values in $PROD_ENV: ${missing[*]}"
    ok 'required values present'

    # Only the empty secrets are generated: an existing one is never replaced (it encrypts or signs stored data).
    local generated=()
    gen_if_empty() {
        if [ -z "$(env_get "$1" "$PROD_ENV")" ]; then
            env_set "$1" "$2" "$PROD_ENV"
            generated+=("$1")
        fi
    }
    gen_if_empty APP_SECRET "$(openssl rand -hex 32)"
    gen_if_empty APP_ENCRYPTION_KEYS "key1=$(openssl rand -base64 32)"
    gen_if_empty APP_HASH_PEPPER "key1=$(openssl rand -base64 32)"
    gen_if_empty APP_AGENT_SIGNING_KEY "$(openssl rand -base64 32)"
    gen_if_empty POSTGRES_PASSWORD "$(openssl rand -hex 24)"
    gen_if_empty DEPVERIFY_APP_PASSWORD "$(openssl rand -hex 24)"
    gen_if_empty DEPVERIFY_OWNER_PASSWORD "$(openssl rand -hex 24)"

    if [ ${#generated[@]} -gt 0 ]; then
        ok "generated: ${generated[*]}"
        warn "back up $PROD_ENV outside this server now: without APP_ENCRYPTION_KEYS the stored secrets are lost,"
        warn 'without APP_AGENT_SIGNING_KEY every agent must be installed again'
    else
        ok 'secrets already set, none generated'
    fi

    # The owner credentials are derived from prod.env on every run, so both files never disagree.
    local owner_password db
    owner_password=$(env_get DEPVERIFY_OWNER_PASSWORD "$PROD_ENV")
    db=$(env_get POSTGRES_DB "$PROD_ENV"); db="${db:-app}"
    (
        umask 077
        printf '# Generated by bin/install-console from %s (DEPVERIFY_OWNER_PASSWORD): do not edit, run the script again.\n' "$PROD_ENV"
        printf 'DATABASE_MIGRATIONS_URL=postgresql://depverify_owner:%s@database:5432/%s?serverVersion=18&charset=utf8\n' "$owner_password" "$db"
    ) > "$OWNER_ENV"
    chmod 600 "$OWNER_ENV"
    ok "$OWNER_ENV in sync"
}

# ---------------------------------------------------------------------------------------------------------------------
# Image acquisition: both ways end with IMAGE_REF, the local image the console containers must run.

cosign() {
    docker run --rm "$COSIGN_IMAGE" "$@"
}

# Verifies the signature of :latest (any release of this repository) and prints the digest cosign vouches for.
verify_latest() {
    local output errors digest
    errors=$(mktemp)
    if ! output=$(cosign verify "$CONSOLE_IMAGE_REPO:latest" \
        --certificate-identity-regexp "$RELEASE_IDENTITY_REGEXP" \
        --certificate-oidc-issuer "$SIGSTORE_ISSUER" --output json 2> "$errors"); then
        if grep -qiE 'no matching signatures|no signatures found|certificate|signature' "$errors"; then
            rm -f "$errors"
            die "the signature of $CONSOLE_IMAGE_REPO:latest is not valid: do not install it, report it (https://github.com/DependencyVerifier/console/issues)"
        fi
        sed 's/^/  /' "$errors" >&2
        rm -f "$errors"
        die "$CONSOLE_IMAGE_REPO:latest or Sigstore cannot be reached (see above): retry later, or build the image on this server (bin/install-console --build)"
    fi
    rm -f "$errors"
    digest=$(printf '%s' "$output" | verified_digest)
    [ -n "$digest" ] || die 'cosign verified no image digest: do not install, report it'
    printf '%s' "$digest"
}

# The version label of a local image or container, or nothing.
version_label() {
    docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$1" 2> /dev/null || true
}

# Version rules: the published version is neither older than the checkout (release not published yet) nor older than
# the version in service (unless --allow-downgrade); newer than the checkout asks to update the checkout.
guard_version() {
    local published="$1" checkout in_service php_container
    if checkout=$(checkout_tag); then
        checkout="${checkout#v}"
        if version_lt "$published" "$checkout"; then
            die "v$checkout is not published on GHCR yet (published version: $published): the release workflow may still run, retry later; or that release failed: git checkout v$published"
        fi
        if version_lt "$checkout" "$published"; then
            warn "the published version $published is newer than the checkout v$checkout: update the checkout, git fetch --tags && git checkout v$published"
        fi
    else
        warn 'the checkout is not on a release tag: published version not compared with it'
    fi

    php_container=$(docker compose ps --quiet php 2> /dev/null || true)
    in_service=''
    [ -z "$php_container" ] || in_service=$(version_label "$php_container")
    if [ -z "$in_service" ]; then
        warn 'no version in service (first install, or an image built without version): downgrade not checked'
    elif version_lt "$published" "$in_service"; then
        [ "$ALLOW_DOWNGRADE" -eq 1 ] \
            || die "the published version $published is lower than the version in service $in_service: run with --allow-downgrade to go back"
        warn "downgrade allowed: from $in_service to $published"
    fi
}

acquire_verified_image() {
    step "Image ($CONSOLE_IMAGE_REPO:latest, signature checked)"
    local digest published
    digest=$(verify_latest)
    docker pull --quiet "$CONSOLE_IMAGE_REPO@$digest" > /dev/null

    published=$(version_label "$CONSOLE_IMAGE_REPO@$digest")
    [[ "$published" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the verified image carries no release version: do not install, report it"
    # The label must be the release that signed the image: verify that exact identity on that digest.
    cosign verify "$CONSOLE_IMAGE_REPO@$digest" --certificate-identity "$(release_identity "$published")" \
        --certificate-oidc-issuer "$SIGSTORE_ISSUER" > /dev/null 2>&1 \
        || die "the image says version $published but was not signed by release v$published: do not install, report it"

    guard_version "$published"

    # The local :latest is the verified digest: Compose starts it with --pull never, nothing else is pulled.
    docker tag "$CONSOLE_IMAGE_REPO@$digest" "$CONSOLE_IMAGE_REPO:latest"
    IMAGE_REF="$CONSOLE_IMAGE_REPO@$digest"
    ok "version $published, $digest"
}

acquire_built_image() {
    # After prod.env is loaded (it sets COMPOSE_FILE): the build file only for this run.
    export COMPOSE_FILE="$COMPOSE_FILE:compose.build.yaml"
    local tag
    tag=$(checkout_tag) || tag=''
    export CONSOLE_BUILD_VERSION="${tag#v}"

    step 'Git submodules'
    make submodules

    step 'Building the image (--build)'
    docker compose build --pull
    IMAGE_REF="${IMAGES_PREFIX:-}app-php-prod"
    warn 'image built from the checkout: version checks skipped; a later docker compose up -d without compose.build.yaml goes back to the published image'
}

# The containers php, worker and cron run IMAGE_REF (image ids, never references: a tag may have moved).
check_running_image() {
    local expected service container actual
    expected=$(docker image inspect --format '{{.Id}}' "$IMAGE_REF")
    for service in php worker cron; do
        container=$(docker compose ps --quiet "$service")
        actual=$(docker inspect --format '{{.Image}}' "$container")
        [ "$actual" = "$expected" ] || die "$service runs $actual instead of $IMAGE_REF ($expected): stopped here, run the script again"
    done
    ok "php, worker and cron run $IMAGE_REF"
}

# ---------------------------------------------------------------------------------------------------------------------
install() {
    set -a
    # shellcheck source=/dev/null
    . "./$PROD_ENV"
    set +a

    if [ "$BUILD" -eq 1 ]; then
        acquire_built_image
    else
        acquire_verified_image
    fi
    [ -n "$IMAGE_REF" ] || die 'no image acquired'

    step 'Starting the database'
    docker compose up -d --wait database

    # Every run: roles.sh only runs on a fresh volume, so this realigns the role passwords with prod.env.
    step 'Database roles'
    make db-roles

    # --pull never: only the acquired image may start (the database was pulled above with its own policy).
    step 'Starting the console (php, worker, cron)'
    docker compose up -d --wait --remove-orphans --no-build --pull never php worker cron
    check_running_image

    step 'Migrations'
    make db-migrate

    step 'Audit log partitions'
    make audit-partitions

    step 'Agent release'
    # Network dependent and run daily by the cron: a failure here does not stop the installation.
    if ! make agent-release-sync; then
        warn 'agent release not synced now (network?): the cron retries daily, or run: make agent-release-sync'
    fi

    if [ -n "$SUPER_ADMIN_EMAIL" ]; then
        step 'Super admin'
        [ -t 0 ] || die 'creating a super admin needs a terminal (the password is typed hidden)'
        make super-admin email="$SUPER_ADMIN_EMAIL"
    fi

    step 'Done'
    docker compose ps
    # shellcheck disable=SC2153 # exported by prod.env
    printf '\nConsole: %s\n' "$DEFAULT_URI"
    if [ -z "$SUPER_ADMIN_EMAIL" ]; then
        printf 'First install? Create the super admin: bin/install-console --super-admin you@example.com\n'
        printf '                                   (or: set -a; . ./prod.env; set +a; make super-admin email=you@example.com)\n'
    fi
    printf 'Keep a copy of %s and %s outside this server.\n' "$PROD_ENV" "$OWNER_ENV"
}

check_prerequisites
[ "$CHECK_ONLY" -eq 1 ] && { printf '\nAll prerequisites are met.\n'; exit 0; }
prepare_prod_env
install
