{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Agent API (protocol §3, §8.3): a snapshot upload is at most 20 MB compressed, any other request 1 MiB. Refused
	# here before PHP reads anything; the application checks the same limits and answers a problem document.
	@agentSnapshot path_regexp ^/agent/v1/inventories/[^/]+/snapshots/
	request_body @agentSnapshot {
		max_size 20MiB
	}
	@agentRequest {
		path /agent/v1/*
		not path_regexp ^/agent/v1/inventories/[^/]+/snapshots/
	}
	request_body @agentRequest {
		max_size 1MiB
	}

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
