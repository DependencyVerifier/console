{#- One notice of a notification email (inline styles only). -#}
<p style="margin:0 0 4px;font-weight:600">{{ ('notification.event.' ~ item.event)|trans({}, 'email') }} · {{ item.title }}</p>
<p style="margin:0 0 4px;color:#52525b">
    {{ item.team }}{% if item.subject %} · {{ item.subject }}{% endif %}
    {%- if item.details.installed is defined and item.details.installed %} · {{ item.details.package ?? '' }} {{ item.details.installed }}{% endif %}
    {%- if item.details.fixed is defined and item.details.fixed %} → {{ item.details.fixed }}{% endif %}
    {%- if item.details.severity is defined and item.details.severity %} · {{ item.details.severity }}{% endif %}
    {%- if item.details.cvss is defined and item.details.cvss is not null %} · CVSS {{ item.details.cvss }}{% endif %}
    {%- if item.details.known_exploited is defined and item.details.known_exploited %} · {{ 'notification.known_exploited'|trans({}, 'email') }}{% endif %}
    {%- if item.details.end_of_life is defined and item.details.end_of_life %} · {{ 'notification.end_of_life'|trans({date: item.details.end_of_life}, 'email') }}{% endif %}
    {%- if item.details.last_seen_at is defined %} · {{ 'notification.last_seen'|trans({date: item.details.last_seen_at}, 'email') }}{% endif %}
    {%- if item.details.expires_on is defined and item.details.expires_on %} · {{ 'notification.expires_on'|trans({date: item.details.expires_on}, 'email') }}{% endif %}
</p>
<p style="margin:0 0 16px"><a href="{{ item.url }}" style="color:#18181b">{{ 'notification.open'|trans({}, 'email') }}</a></p>
