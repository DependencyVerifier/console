{% extends 'email/layout.html.twig' %}
{% block content %}
    <p>{{ 'identity.password_reset.intro'|trans({}, 'email') }}</p>
    <p><a href="{{ url }}" style="display:inline-block;padding:8px 14px;background:#18181b;color:#ffffff;border-radius:6px;text-decoration:none">{{ 'identity.password_reset.action'|trans({}, 'email') }}</a></p>
    <p>{{ 'identity.password_reset.validity'|trans({minutes: validity_minutes}, 'email') }}</p>
    <p style="color:#71717a">{{ 'identity.password_reset.ignore'|trans({}, 'email') }}</p>
{% endblock %}
