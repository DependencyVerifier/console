{% extends 'email/layout.html.twig' %}
{% block content %}
    <p>{{ 'organization.invitation.intro'|trans({}, 'email') }}</p>
    <p><a href="{{ url }}" style="display:inline-block;padding:8px 14px;background:#18181b;color:#ffffff;border-radius:6px;text-decoration:none">{{ 'organization.invitation.action'|trans({}, 'email') }}</a></p>
    <p>{{ 'organization.invitation.validity'|trans({days: validity_days}, 'email') }}</p>
    <p style="color:#71717a">{{ 'organization.invitation.ignore'|trans({}, 'email') }}</p>
{% endblock %}
