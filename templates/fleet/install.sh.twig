{% autoescape false %}#!/bin/sh
# DependencyVerifier agent installer, generated by {{ console_url }} (cadrage §6).
# Usage: curl --proto '=https' --tlsv1.2 -fsSL {{ console_url }}/install.sh | sudo AGENT_TOKEN='dvet_…' sh
# Optional: AGENT_DOCKER=1 (read Docker too: root-equivalent, prefer a read-only socket proxy).
# The whole script is a function called on its last line: a download cut short runs nothing.
set -eu

CONSOLE_URL='{{ console_url }}'
CONSOLE_PUBKEY='{{ console_key }}'
AGENT_VERSION='{{ release.version }}'

fail() {
    echo "depverify-agent install: $*" >&2
    exit 1
}

main() {
    [ "$(id -u)" -eq 0 ] || fail "run it as root (sudo)"
    command -v systemctl >/dev/null 2>&1 || fail "systemd is required (use the container image otherwise)"
    command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"
    [ -n "${AGENT_TOKEN:-}" ] || [ -f /var/lib/depverify-agent/agent.key ] || fail "AGENT_TOKEN is required for a first installation"

    case "$(uname -m)" in
{% for architecture, binary in release.binaries %}
        {{ architecture == 'x86_64' ? 'x86_64|amd64' : 'aarch64|arm64' }}) NAME='{{ binary.name }}'; SHA256='{{ binary.sha256 }}' ;;
{% endfor %}
        *) fail "unsupported architecture $(uname -m)" ;;
    esac

    TMP="$(mktemp -d)"
    trap 'rm -rf "$TMP"' EXIT
    curl --proto '=https' --tlsv1.2 -fsSL -o "$TMP/depverify-agent" "$CONSOLE_URL/downloads/agent/$AGENT_VERSION/$NAME"
    echo "$SHA256  $TMP/depverify-agent" | sha256sum -c - >/dev/null || fail "checksum mismatch: the binary was not installed"
    install -m 0755 "$TMP/depverify-agent" /usr/local/bin/depverify-agent

    if ! id depverify-agent >/dev/null 2>&1; then
        useradd --system --no-create-home --home-dir /var/lib/depverify-agent --shell /usr/sbin/nologin depverify-agent
    fi
    install -d -m 0750 -g depverify-agent /etc/depverify-agent
    umask 027
    {
        echo "AGENT_CONSOLE_URL=$CONSOLE_URL"
        echo "AGENT_CONSOLE_PUBKEY=$CONSOLE_PUBKEY"
        echo "AGENT_TOKEN_FILE=/etc/depverify-agent/token"
        if [ "${AGENT_DOCKER:-}" = "1" ]; then echo "AGENT_DOCKER=1"; fi
    } > /etc/depverify-agent/agent.env
    chgrp depverify-agent /etc/depverify-agent/agent.env
    if [ -n "${AGENT_TOKEN:-}" ]; then
        printf '%s' "$AGENT_TOKEN" > /etc/depverify-agent/token
        chgrp depverify-agent /etc/depverify-agent/token
    fi
    if [ "${AGENT_DOCKER:-}" = "1" ] && getent group docker >/dev/null 2>&1; then
        usermod -aG docker depverify-agent
    fi

    cat > /etc/systemd/system/depverify-agent.service <<'UNIT'
[Unit]
Description=DependencyVerifier agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=depverify-agent
Group=depverify-agent
EnvironmentFile=/etc/depverify-agent/agent.env
Environment=AGENT_MODE=host
ExecStart=/usr/local/bin/depverify-agent run
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=3
StateDirectory=depverify-agent
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/depverify-agent
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable --now depverify-agent
    systemctl restart depverify-agent
    echo "depverify-agent $AGENT_VERSION installed. Its fingerprint, to compare before approving it in the console:"
    sleep 3
    if command -v journalctl >/dev/null 2>&1; then
        journalctl -u depverify-agent --no-pager -n 20 | grep -o 'fingerprint SHA256:[^ ]*' | tail -1 || true
    fi
}

main "$@"
{% endautoescape %}
