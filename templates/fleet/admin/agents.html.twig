{% extends 'shared/layout/app.html.twig' %}

{% block title %}{{ 'fleet.admin.title'|trans }} · DependencyVerifier{% endblock %}

{% block breadcrumb %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            <twig:Breadcrumb:Item>{{ 'admin.title'|trans }}</twig:Breadcrumb:Item>
            <twig:Breadcrumb:Separator />
            <twig:Breadcrumb:Item><twig:Breadcrumb:Page>{{ 'fleet.admin.title'|trans }}</twig:Breadcrumb:Page></twig:Breadcrumb:Item>
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endblock %}

{% block main %}
    {{ include('shared/_flashes.html.twig') }}
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'fleet.admin.title'|trans }}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ 'fleet.admin.description'|trans }}</p>
    </div>
    <twig:DataTable :table="agents" :title="'fleet.admin.title'|trans" />
{% endblock %}
