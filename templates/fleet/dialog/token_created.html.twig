{#- Shown once, in the response of the POST (SecretRevealingResponse): the token, the Compose snippet of
    docs/cadrage.md §6bis and the console key the agent pins. The stream refreshes the lists behind the dialog and
    leaves a confirmation on the page. -#}
<turbo-frame id="{{ frame_id }}">
    <div class="grid gap-4 text-sm">
        <twig:Alert variant="default">
            <twig:ux:icon name="lucide:key-round" />
            <twig:Alert:Title>{{ 'fleet.tokens.shown_once'|trans }}</twig:Alert:Title>
            <twig:Alert:Description>{{ 'fleet.tokens.shown_once_description'|trans }}</twig:Alert:Description>
        </twig:Alert>
        <div>
            <p class="mb-1 text-muted-foreground">{{ 'fleet.tokens.token'|trans }}</p>
            <code class="block rounded-md border bg-muted px-3 py-2 font-mono text-sm break-all select-all">{{ token }}</code>
        </div>
        <div>
            <p class="mb-1 text-muted-foreground">{{ 'fleet.tokens.compose'|trans }}</p>
            <pre class="max-h-72 overflow-auto rounded-md border bg-muted px-3 py-2 font-mono text-xs select-all">
{{- "# echo '" ~ token ~ "' > .agent_token   (" ~ ('fleet.tokens.token_file'|trans) ~ ")\n" -}}
{{- "services:\n  depverify-agent:\n    image: ghcr.io/dependencyverifier/agent@sha256:<digest>\n    restart: unless-stopped\n    environment:\n      AGENT_MODE: container\n      AGENT_SCOPE: compose\n      AGENT_CONSOLE_URL: " ~ console_url ~ "\n      AGENT_CONSOLE_PUBKEY: \"" ~ fleet.consoleKey ~ "\"\n      AGENT_TOKEN_FILE: /run/secrets/agent_token\n      DOCKER_HOST: tcp://depverify-docker-proxy:2375\n    secrets: [agent_token]\n    volumes:\n      - depverify-agent-data:/var/lib/agent\n    networks: [depverify-internal, default]\n    read_only: true\n    cap_drop: [ALL]\n    security_opt: [\"no-new-privileges:true\"]\n\n  depverify-docker-proxy:\n    image: tecnativa/docker-socket-proxy:<version>\n    environment: {CONTAINERS: 1, IMAGES: 1, INFO: 1, VERSION: 1, POST: 0}\n    volumes:\n      - /var/run/docker.sock:/var/run/docker.sock:ro\n    networks: [depverify-internal]\n    read_only: true\n\nnetworks:\n  depverify-internal:\n    internal: true\n\nvolumes:\n  depverify-agent-data:\n\nsecrets:\n  agent_token:\n    file: ./.agent_token" -}}
            </pre>
        </div>
        <p class="text-muted-foreground">{{ 'fleet.tokens.console_key'|trans }} <code class="font-mono text-xs break-all">{{ fleet.consoleKeyId }}</code></p>
        <footer class="flex justify-end">
            <twig:Button type="button" data-action="dialog#close">{{ 'fleet.tokens.done'|trans }}</twig:Button>
        </footer>
    </div>
    <turbo-stream action="update" target="action-alerts">
        <template>
            <twig:Alert>
                <twig:ux:icon name="lucide:circle-check" />
                <twig:Alert:Description>{{ 'fleet.tokens.created'|trans }}</twig:Alert:Description>
            </twig:Alert>
        </template>
    </turbo-stream>
</turbo-frame>
