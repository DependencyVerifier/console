{% extends 'organization/team/_layout.html.twig' %}

{% block title %}{{ 'fleet.agents.title'|trans }} · {{ team.name }} · DependencyVerifier{% endblock %}

{% block primary_action %}
    {%- if fleet.can('host.order') %}
        <form method="post" action="{{ path('fleet_team_agents_upgrade', {teamId: team.id}) }}">
            <input type="hidden" name="action[_token]" value="{{ csrf_token('agent_upgrade:' ~ team.id) }}">
            <twig:Tooltip :text="'fleet.agents.upgrade_all_help'|trans"><twig:Button type="submit" variant="outline">{{ 'fleet.agents.upgrade_all'|trans }}</twig:Button></twig:Tooltip>
        </form>
    {%- endif %}
    {%- if fleet.can('host.enroll') %}
        <twig:Button as="a" href="{{ path('fleet_team_enrollment', {teamId: team.id}) }}" variant="outline">{{ 'fleet.agents.enroll'|trans }}</twig:Button>
    {%- endif %}
{% endblock %}

{% block tab %}
    <p class="text-sm text-muted-foreground">{{ 'fleet.agents.description'|trans }}</p>
    <twig:DataTable :table="tables.agents" :title="'fleet.agents.title'|trans" />
{% endblock %}
