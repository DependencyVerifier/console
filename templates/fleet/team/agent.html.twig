{% extends 'organization/team/_layout.html.twig' %}
{#- One agent (variables: team, fleet, agent, tables.orders). -#}

{% block title %}{{ agent.hostname }} · {{ 'fleet.agents.title'|trans }} · {{ team.name }} · DependencyVerifier{% endblock %}

{#- The object is the agent: its own breadcrumb and header (hostname, status, mode), the gestures beside it. -#}
{% block breadcrumb %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            <twig:Breadcrumb:Item><twig:Breadcrumb:Link href="{{ path('organization_team', {teamId: team.id}) }}">{{ team.name }}</twig:Breadcrumb:Link></twig:Breadcrumb:Item>
            <twig:Breadcrumb:Separator />
            <twig:Breadcrumb:Item><twig:Breadcrumb:Link href="{{ path('fleet_team_agents', {teamId: team.id}) }}">{{ 'fleet.agents.title'|trans }}</twig:Breadcrumb:Link></twig:Breadcrumb:Item>
            <twig:Breadcrumb:Separator />
            <twig:Breadcrumb:Item><twig:Breadcrumb:Page>{{ agent.hostname }}</twig:Breadcrumb:Page></twig:Breadcrumb:Item>
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endblock %}

{% block header %}
    <header class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex min-w-0 items-center gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg border bg-muted text-muted-foreground" aria-hidden="true">
                <twig:ux:icon name="lucide:server" class="size-5" />
            </span>
            <div class="min-w-0">
                <h1 class="font-mono text-2xl font-semibold tracking-tight [overflow-wrap:anywhere]">{{ agent.hostname }}</h1>
                <p class="flex flex-wrap items-center gap-x-2 text-sm text-muted-foreground">
                    {{ include('fleet/cells/agent_status.html.twig', {row: agent}) }}
                    <span aria-hidden="true">·</span>
                    <span>{{ include('fleet/cells/agent_runtime.html.twig', {row: agent}) }}</span>
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            {%- if fleet.can('host.order') and agent.upgradeTo %}
                <form method="post" action="{{ path('fleet_agent_upgrade', {teamId: team.id, agentId: agent.id}) }}">
                    <input type="hidden" name="action[_token]" value="{{ csrf_token('agent_upgrade:' ~ agent.id) }}">
                    <twig:Button type="submit">{{ 'fleet.agents.upgrade'|trans({version: agent.upgradeTo}) }}</twig:Button>
                </form>
            {%- endif %}
            {%- if fleet.can('host.order') and agent.status == 'approved' %}
                <form method="post" action="{{ path('fleet_agent_rotate_key', {teamId: team.id, agentId: agent.id}) }}">
                    <input type="hidden" name="action[_token]" value="{{ csrf_token('agent_rotate_key:' ~ agent.id) }}">
                    <twig:Button type="submit" variant="outline" title="{{ 'fleet.agents.rotate_key_help'|trans }}"><twig:ux:icon name="lucide:key-round" />{{ 'fleet.agents.rotate_key'|trans }}</twig:Button>
                </form>
                <form method="post" action="{{ path('fleet_agent_scan', {teamId: team.id, agentId: agent.id}) }}">
                    <input type="hidden" name="action[_token]" value="{{ csrf_token('agent_scan:' ~ agent.id) }}">
                    <twig:Button type="submit" variant="outline"><twig:ux:icon name="lucide:radar" />{{ 'fleet.agents.scan_now'|trans }}</twig:Button>
                </form>
                <twig:FormDialog
                    id="configure-agent"
                    :title="'fleet.configure.title'|trans({host: agent.hostname})"
                    :description="'fleet.configure.description'|trans"
                    :trigger="'fleet.configure.open'|trans"
                    :src="path('fleet_agent_configure', {teamId: team.id, agentId: agent.id})"
                />
            {%- endif %}
        </div>
    </header>
{% endblock %}

{% block tab %}
    {%- set config = agent.desiredConfig -%}
    <section class="grid gap-4 rounded-lg border p-4">
        <dl class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
            <div class="sm:col-span-2 lg:col-span-3">
                <dt class="text-muted-foreground">{{ 'fleet.field.fingerprint'|trans }}</dt>
                <dd><code class="font-mono text-sm break-all">{{ agent.fingerprint }}</code></dd>
            </div>
            <div>
                <dt class="text-muted-foreground">{{ 'fleet.field.version'|trans }}</dt>
                <dd>{{ agent.version }}</dd>
            </div>
            <div>
                <dt class="text-muted-foreground">{{ 'fleet.field.last_seen'|trans }}</dt>
                <dd>{{ include('fleet/cells/time.html.twig', {value: agent.lastSeenAt}) }}</dd>
            </div>
            <div>
                <dt class="text-muted-foreground">{{ 'fleet.field.scan_interval'|trans }}</dt>
                <dd>{{ config ? 'fleet.configure.every'|trans({minutes: config.scan_interval_minutes}) : 'fleet.configure.agent_default'|trans }}</dd>
            </div>
            <div>
                <dt class="text-muted-foreground">{{ 'fleet.field.config_version'|trans }}</dt>
                <dd class="tabular-nums">{{ 'fleet.configure.versions'|trans({applied: agent.appliedConfigVersion, desired: config.config_version ?? 0}) }}</dd>
            </div>
            {%- for field in ['discovery_roots', 'declared_paths', 'exclusions'] %}
                {%- if config and config[field] is not empty %}
                    <div>
                        <dt class="text-muted-foreground">{{ ('fleet.field.' ~ field)|trans }}</dt>
                        <dd>{% for path in config[field] %}<code class="block font-mono text-xs">{{ path }}</code>{% endfor %}</dd>
                    </div>
                {%- endif %}
            {%- endfor %}
        </dl>
    </section>
    <twig:DataTable :table="tables.orders" :title="'fleet.orders.title'|trans" />
{% endblock %}
