{%- props
    ## string|null URL of the current page; the current request by default.
    href = null
-%}
{#- The current page stays a link, marked aria-current="page" (breadcrumbs guide): never a role="link" span. -#}
<a
    href="{{ href ?? app.request.requestUri }}"
    data-slot="breadcrumb-page"
    aria-current="page"
    {{ attributes.defaults({
        class: 'font-normal text-foreground'|tailwind_classes,
    }) }}
>
    {##- The current page text. -#}
    {%- block content %}{% endblock -%}
</a>
