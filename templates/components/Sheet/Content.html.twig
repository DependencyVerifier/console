{%- props
    ## boolean Whether to display the close button in the top-right corner.
    showCloseButton = true
-%}
{%- set _sheet_id = inject('sheet.id') -%}
{%- set _sheet_titleId = inject('sheet.titleId') -%}
{%- set _sheet_descriptionId = inject('sheet.descriptionId') -%}
{%- set _sheet_side = inject('sheet.side', 'right') -%}
{#- Rendered first so aria-describedby only names a description that exists. -#}
{%- set _sheet_content %}{% block content %}{% endblock %}{% endset -%}
{%- set style = html_cva(
    base: 'fixed z-50 m-0 open:flex max-h-none max-w-none flex-col gap-4 bg-popover bg-clip-padding p-0 text-sm text-popover-foreground shadow-lg outline-hidden overscroll-contain transition duration-200 ease-in-out backdrop:overflow-hidden backdrop:overscroll-contain backdrop:bg-black/10 supports-backdrop-filter:backdrop:backdrop-blur-xs backdrop:opacity-0 backdrop:transition-opacity backdrop:duration-200 backdrop:ease-in-out open:backdrop:opacity-100 starting:open:backdrop:opacity-0 data-closing:backdrop:opacity-0',
    variants: {
        side: {
            right: 'inset-y-0 right-0 left-auto h-full w-3/4 border-l motion-safe:translate-x-full open:translate-x-0 motion-safe:starting:open:translate-x-full motion-safe:data-closing:translate-x-full sm:max-w-sm',
            left: 'inset-y-0 left-0 right-auto h-full w-3/4 border-r motion-safe:-translate-x-full open:translate-x-0 motion-safe:starting:open:-translate-x-full motion-safe:data-closing:-translate-x-full sm:max-w-sm',
            top: 'inset-x-0 top-0 bottom-auto h-auto w-auto border-b motion-safe:-translate-y-full open:translate-y-0 motion-safe:starting:open:-translate-y-full motion-safe:data-closing:-translate-y-full',
            bottom: 'inset-x-0 bottom-0 top-auto h-auto w-auto border-t motion-safe:translate-y-full open:translate-y-0 motion-safe:starting:open:translate-y-full motion-safe:data-closing:translate-y-full',
        },
    },
) -%}
<dialog
    id="{{ _sheet_id }}"
    aria-labelledby="{{ _sheet_titleId }}"
    {% if ('id="' ~ _sheet_descriptionId ~ '"') in _sheet_content %}aria-describedby="{{ _sheet_descriptionId }}"{% endif %}
    data-slot="sheet-content"
    data-dialog-target="dialog"
    data-side="{{ _sheet_side }}"
    {{ attributes.defaults({
        class: style.apply({side: _sheet_side})|tailwind_classes,
        'data-action': 'cancel->dialog#cancel close->dialog#closed pointerdown->dialog#pointerDown click->dialog#closeOnClickOutside',
    }) }}
>
    {##- The sheet content, typically includes `Sheet:Header` and optionally `Sheet:Footer`. -#}
    {{- _sheet_content -}}
    {% if showCloseButton %}
        <twig:Button
            type="button"
            variant="ghost"
            size="icon-sm"
            class="absolute top-3 end-3"
            data-slot="sheet-close"
            data-action="click->dialog#close"
        >
            <twig:ux:icon name="lucide:x" />
            <span class="sr-only">Close</span>
        </twig:Button>
    {% endif %}
</dialog>
