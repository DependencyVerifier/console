{%- props
    ## string Key of the active navigation entry.
    active = 'overview',
    ## string|null Id of the team being browsed.
    team = null,
    ## array{id:string,name:string,tab:string,tabs:list<string>}|null The project being browsed, listed under Projects.
    project = null
-%}
{%- set user = app.user -%}
{%- set myTeams = user ? sidebar_teams() : [] -%}
{%- set currentTeam = team ?? (myTeams|first ? (myTeams|first).id : null) -%}
{#- The sections of the selected team (UI hints: each page checks again). Members and the fleet (Hosts, Agents,
    Enrollment): not for a TEAM_GUEST; Settings: for
    a TEAM_ADMIN or a super admin (team.edit is never granted on top of another role). Without a team, the home page. -#}
{%- set roleKey = (myTeams|filter(t => t.id == currentTeam)|first).role_key ?? '' -%}
{%- set superAdmin = is_granted('ROLE_SUPER_ADMIN') -%}
{%- set teamNav = currentTeam ? [
    {key: 'team_overview', title: 'nav.overview'|trans, url: path('organization_team', {teamId: currentTeam}), icon: 'lucide:layout-dashboard'},
    {key: 'team_projects', title: 'nav.projects'|trans, url: path('organization_team_projects', {teamId: currentTeam}), icon: 'lucide:layers'},
]|merge(roleKey != 'team_guest' ? [
    {key: 'team_members', title: 'nav.team_members'|trans, url: path('organization_team_members', {teamId: currentTeam}), icon: 'lucide:users'},
    {key: 'team_hosts', title: 'nav.hosts'|trans, url: path('fleet_team_hosts', {teamId: currentTeam}), icon: 'lucide:server'},
    {key: 'team_agents', title: 'nav.agents'|trans, url: path('fleet_team_agents', {teamId: currentTeam}), icon: 'lucide:radio-tower'},
    {key: 'team_enrollment', title: 'nav.enrollment'|trans, url: path('fleet_team_enrollment', {teamId: currentTeam}), icon: 'lucide:key-round'},
] : [])|merge(roleKey == 'team_admin' or superAdmin ? [
    {key: 'team_settings', title: 'nav.team_settings'|trans, url: path('organization_team_settings', {teamId: currentTeam}), icon: 'lucide:settings'},
] : [])|merge(roleKey == 'team_admin' or superAdmin ? [
    {key: 'team_audit', title: 'nav.team_audit'|trans, url: path('audit_team_audit', {teamId: currentTeam}), icon: 'lucide:scan-search'},
] : []) : [
    {key: 'overview', title: 'nav.overview'|trans, url: path('shared_home'), icon: 'lucide:layout-dashboard'},
] -%}
{#- The project being browsed has its own group, titled with its name, below the team's: its environments, members and
    settings are the project's, never the team's. -#}
{%- set projectNav = project ? project.tabs|map(t => {
    key: 'project_' ~ t,
    title: ('nav.project_' ~ t)|trans,
    url: path({overview: 'organization_project', environments: 'organization_project_environments', members: 'organization_project_members', settings: 'organization_project_settings'}[t], {teamId: currentTeam, projectId: project.id}),
    icon: {overview: 'lucide:layout-dashboard', environments: 'lucide:server', members: 'lucide:users', settings: 'lucide:settings'}[t],
}) : [] -%}
{%- set data = {
    user: {name: user ? user.label : '', email: user ? user.userIdentifier : ''},
    teams: myTeams,
    navMain: teamNav,
    navSecondary: superAdmin ? [
        {key: 'admin_users', title: 'nav.users'|trans, url: path('identity_admin_users'), icon: 'lucide:shield-check'},
        {key: 'admin_teams', title: 'nav.teams'|trans, url: path('organization_admin_teams'), icon: 'lucide:building-2'},
        {key: 'admin_agents', title: 'nav.agents'|trans, url: path('fleet_admin_agents'), icon: 'lucide:radio-tower'},
        {key: 'admin_audit', title: 'nav.audit'|trans, url: path('audit_admin_audit'), icon: 'lucide:scan-search'},
    ] : [],
} -%}
<twig:Sidebar {{ ...attributes.defaults({collapsible: 'icon'}) }}>
    <twig:Sidebar:Header>
        {#- Application logo first; collapsed to the mark alone in icon mode. -#}
        <twig:Sidebar:Menu>
            <twig:Sidebar:MenuItem>
                <twig:Sidebar:MenuButton as="a" href="{{ path('shared_home') }}" size="lg" tooltip="DependencyVerifier">
                    <twig:AppLogo />
                    <span class="truncate font-semibold">DependencyVerifier</span>
                </twig:Sidebar:MenuButton>
            </twig:Sidebar:MenuItem>
        </twig:Sidebar:Menu>
        <twig:TeamSwitcher :teams="data.teams" :current="currentTeam" />
    </twig:Sidebar:Header>
    <twig:Sidebar:Content>
        <twig:NavMain :items="data.navMain" :active="active" :label="currentTeam ? 'nav.team_group'|trans : null" />
        {%- if projectNav|length %}
            <twig:NavMain :items="projectNav" :active="active" :label="'nav.project_group'|trans({name: project.name})" />
        {%- endif %}
        {%- if data.navSecondary %}
            <twig:NavMain :items="data.navSecondary" :active="active" :label="'nav.administration'|trans" class="mt-auto" />
        {%- endif %}
    </twig:Sidebar:Content>
    <twig:Sidebar:Footer>
        <twig:NavUser :user="data.user" />
    </twig:Sidebar:Footer>
    <twig:Sidebar:Rail />
</twig:Sidebar>
