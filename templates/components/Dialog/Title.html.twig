{%- set _dialog_titleId = inject('dialog.titleId') -%}
{#- A modal dialog is its own document for assistive technologies: its title is a level-1 heading. -#}
<h1
    id="{{ _dialog_titleId }}"
    data-slot="dialog-title"
    {{ attributes.without('id').defaults({tabindex: '-1', class: 'cn-font-heading text-base leading-none font-medium outline-hidden'|tailwind_classes}) }}
>
    {##- The title text of the dialog. -#}
    {%- block content %}{% endblock -%}
</h1>
