{%- props
    ## array<array{key:string,label:string,url:string}> The tabs, in their order; each one is its own page.
    items,
    ## string Key of the current tab.
    active,
    ## string Accessible name of the navigation.
    label
-%}
{#- Tabs as links (one URL per tab, decision of the team page): the look of `Tabs:List` variant `line`, without its
    controller, since nothing is hidden on the page. Scrolls sideways on a narrow screen instead of wrapping. -#}
<nav aria-label="{{ label }}" {{ attributes.defaults({class: 'overflow-x-auto overflow-y-hidden border-b'|tailwind_classes}) }}>
    <ul class="flex min-w-max gap-5">
        {%- for item in items %}
            {%- set current = item.key == active -%}
            <li>
                <a
                    href="{{ item.url }}"
                    {% if current %}aria-current="page"{% endif %}
                    class="relative inline-flex h-9 items-center text-sm font-medium transition-colors outline-none after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-foreground after:transition-opacity focus-visible:rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 {{ current ? 'text-foreground after:opacity-100' : 'text-muted-foreground after:opacity-0 hover:text-foreground' }}"
                >{{ item.label }}</a>
            </li>
        {%- endfor %}
    </ul>
</nav>
