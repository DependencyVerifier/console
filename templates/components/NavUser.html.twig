{%- props
    ## array{name:string,email:string} The signed-in user.
    user
-%}
<twig:Sidebar:Menu>
    <twig:Sidebar:MenuItem>
        <twig:DropdownMenu id="nav-user" side="right" align="end" class="block w-full">
            <twig:DropdownMenu:Trigger>
                <twig:Sidebar:MenuButton
                    {{ ...dropdown_menu_trigger_attrs }}
                    size="lg"
                    tooltip="{{ user.name }}"
                    class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground"
                >
                    <twig:Avatar class="h-8 w-8 rounded-lg">
                        <twig:Avatar:Fallback class="rounded-lg">{{ user.name|split(' ')|map(w => w|first)|join|upper|slice(0, 2) }}</twig:Avatar:Fallback>
                    </twig:Avatar>
                    <div class="grid flex-1 text-start text-sm leading-tight">
                        <span class="truncate font-medium">{{ user.name }}</span>
                        <span class="truncate text-xs">{{ user.email }}</span>
                    </div>
                    <twig:ux:icon name="lucide:chevrons-up-down" class="ms-auto size-4" />
                </twig:Sidebar:MenuButton>
            </twig:DropdownMenu:Trigger>
            {#- On mobile the sidebar is a sheet that clips what passes its edge: the menu opens above the button, inside it. Fallback only: where the menu is a native popover (top layer), app.css places it. -#}
            <twig:DropdownMenu:Content class="w-max max-md:left-0 max-md:ml-0 max-md:bottom-full max-md:mb-2 max-md:w-full">
                <twig:DropdownMenu:Label class="p-0 font-normal">
                    <div class="flex items-center gap-2 px-1 py-1.5 text-start text-sm">
                        <twig:Avatar class="h-8 w-8 rounded-lg">
                            <twig:Avatar:Fallback class="rounded-lg">{{ user.name|split(' ')|map(w => w|first)|join|upper|slice(0, 2) }}</twig:Avatar:Fallback>
                        </twig:Avatar>
                        <div class="grid flex-1 text-start text-sm leading-tight">
                            <span class="truncate font-medium">{{ user.name }}</span>
                            <span class="truncate text-xs">{{ user.email }}</span>
                        </div>
                    </div>
                </twig:DropdownMenu:Label>
                <twig:DropdownMenu:Separator />
                <twig:DropdownMenu:Group>
                    <twig:DropdownMenu:Item as="a" href="{{ path('identity_account_security') }}">
                        <twig:ux:icon name="lucide:key-round" />
                        {{ 'nav.account_security'|trans }}
                    </twig:DropdownMenu:Item>
                </twig:DropdownMenu:Group>
                <twig:DropdownMenu:Separator />
                {#- Logout is a POST with a CSRF token (it also purges Turbo's page cache). -#}
                <form method="post" action="{{ path('identity_logout') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <twig:DropdownMenu:Item type="submit">
                        <twig:ux:icon name="lucide:log-out" />
                        {{ 'nav.logout'|trans }}
                    </twig:DropdownMenu:Item>
                </form>
            </twig:DropdownMenu:Content>
        </twig:DropdownMenu>
    </twig:Sidebar:MenuItem>
</twig:Sidebar:Menu>
