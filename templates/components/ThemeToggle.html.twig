{#- Cycles system -> light -> dark. The icon shown follows data-theme-preference. -#}
<twig:Button
    variant="ghost"
    size="icon"
    data-controller="theme"
    data-action="theme#cycle"
    aria-label="Switch theme"
    class="group/theme"
    {{ ...attributes }}
>
    <twig:ux:icon name="lucide:monitor" class="hidden group-data-[theme-preference=system]/theme:block" />
    <twig:ux:icon name="lucide:sun" class="hidden group-data-[theme-preference=light]/theme:block" />
    <twig:ux:icon name="lucide:moon" class="hidden group-data-[theme-preference=dark]/theme:block" />
</twig:Button>
