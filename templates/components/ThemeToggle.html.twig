{#- Cycles system -> light -> dark. The icon and the action text shown follow data-theme-preference
    (dark-mode-toggle: the accessible name tells the current theme and what a press does). -#}
<twig:Button
    variant="ghost"
    size="icon"
    data-controller="theme"
    data-action="theme#cycle"
    class="group/theme"
    {{ ...attributes }}
>
    <twig:ux:icon name="lucide:monitor" aria-hidden="true" class="hidden group-data-[theme-preference=system]/theme:block" />
    <twig:ux:icon name="lucide:sun" aria-hidden="true" class="hidden group-data-[theme-preference=light]/theme:block" />
    <twig:ux:icon name="lucide:moon" aria-hidden="true" class="hidden group-data-[theme-preference=dark]/theme:block" />
    {#- Classes written out in full: Tailwind only sees literal class names. -#}
    <span class="sr-only hidden group-data-[theme-preference=system]/theme:block">{{ 'theme.system'|trans }}</span>
    <span class="sr-only hidden group-data-[theme-preference=light]/theme:block">{{ 'theme.light'|trans }}</span>
    <span class="sr-only hidden group-data-[theme-preference=dark]/theme:block">{{ 'theme.dark'|trans }}</span>
</twig:Button>
