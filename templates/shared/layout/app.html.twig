{% extends 'base.html.twig' %}

{#- Authenticated area: Turbo's page cache ignores Cache-Control, so a back navigation must never show a page
    without asking the server again; no prefetch on hover. -#}
{% block head_meta %}
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-prefetch" content="false">
{% endblock %}

{% block body %}
    {#- Page blocks are rendered outside the component tags: Twig components reserve block names inside their content. -#}
    {%- set _breadcrumb %}{% block breadcrumb %}{% endblock %}{% endset -%}
    {%- set _main %}{% block main %}{% endblock %}{% endset -%}
    {#- Skip link (WCAG 2.4.1): first focusable element, shown on focus. -#}
    <a href="#main-content" class="sr-only z-50 rounded-md bg-background px-3 py-2 text-sm font-medium shadow-md ring-2 ring-ring focus:not-sr-only focus:fixed focus:start-2 focus:top-2">{{ 'nav.skip'|trans }}</a>
    <twig:Sidebar:Provider>
        <twig:AppSidebar active="{{ nav_active|default('overview') }}" :team="current_team|default(null)" :project="current_project|default(null)" />
        <twig:Sidebar:Inset>
            <header class="flex min-h-14 shrink-0 items-center gap-2 border-b px-4">
                <twig:Sidebar:Trigger class="-ms-1">
                    <twig:ux:icon name="lucide:panel-left" />
                </twig:Sidebar:Trigger>
                <twig:Separator orientation="vertical" class="me-2 data-vertical:h-4 data-vertical:self-auto" />
                {{ _breadcrumb }}
                <div class="ms-auto flex items-center gap-1">
                    <twig:ThemeToggle />
                </div>
            </header>
            <main id="main-content" tabindex="-1" class="mx-auto outline-hidden flex w-full max-w-7xl flex-1 flex-col gap-6 p-6">
                {{ _main }}
            </main>
            <twig:AppFooter />
        </twig:Sidebar:Inset>
    </twig:Sidebar:Provider>
{% endblock %}
