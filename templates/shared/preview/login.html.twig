{% extends 'shared/layout/auth.html.twig' %}

{#- Static preview of the sign-in screen (docs/design.md §6). No authentication logic yet. -#}
{% block title %}Sign in · DepRadar{% endblock %}

{% block main %}
    <div class="flex flex-col gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
            <p class="mt-1 text-sm text-muted-foreground">Enter your account details to continue.</p>
        </div>

        <form class="flex flex-col gap-6" onsubmit="return false">
            <twig:Field:Group>
                <twig:Field>
                    <twig:Field:Label for="email">Email</twig:Field:Label>
                    <twig:Input id="email" type="email" name="email" autocomplete="username webauthn" required />
                </twig:Field>
                <twig:Field>
                    <div class="flex items-center">
                        <twig:Field:Label for="password">Password</twig:Field:Label>
                        <a href="#" class="ms-auto text-sm text-muted-foreground underline-offset-4 hover:underline">Forgot password?</a>
                    </div>
                    <twig:Input id="password" type="password" name="password" autocomplete="current-password" required />
                </twig:Field>
                <twig:Button type="submit" class="w-full">Sign in</twig:Button>
            </twig:Field:Group>
        </form>

        <twig:Field:Separator>or</twig:Field:Separator>

        <twig:Button variant="outline" type="button" class="w-full">
            <twig:ux:icon name="lucide:key-round" />
            Sign in with a passkey
        </twig:Button>

        <p class="text-center text-xs text-muted-foreground">
            Accounts are created by invitation. Ask your team administrator for access.
        </p>
    </div>
{% endblock %}
