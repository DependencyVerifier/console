{% extends 'shared/layout/app.html.twig' %}

{#- Static preview of an object page (docs/design.md §5). Fictional data; replace with real screens. -#}
{% set nav_active = 'hosts' %}

{% block title %}web-01 · DependencyVerifier{% endblock %}

{% block breadcrumb %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            <twig:Breadcrumb:Item class="hidden md:block">
                <twig:Breadcrumb:Link href="#">Hosts</twig:Breadcrumb:Link>
            </twig:Breadcrumb:Item>
            <twig:Breadcrumb:Separator class="hidden md:block" />
            <twig:Breadcrumb:Item>
                <twig:Breadcrumb:Page>web-01</twig:Breadcrumb:Page>
            </twig:Breadcrumb:Item>
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endblock %}

{% block main %}
    <div class="flex items-start gap-4">
        <div class="flex size-14 shrink-0 items-center justify-center rounded-lg border bg-card">
            <twig:ux:icon name="lucide:server" class="size-6 text-muted-foreground" />
        </div>
        <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-semibold tracking-tight">web-01</h1>
            <p class="text-sm text-muted-foreground">Host in Personal projects · 2 projects</p>
        </div>
        <div class="flex items-center gap-2">
            <twig:Button variant="ghost" size="icon" aria-label="Add to favorites">
                <twig:ux:icon name="lucide:star" />
            </twig:Button>
            <twig:DropdownMenu id="host-actions" align="end">
                <twig:DropdownMenu:Trigger>
                    <twig:Button variant="outline" size="icon" aria-label="More actions" {{ ...dropdown_menu_trigger_attrs }}>
                        <twig:ux:icon name="lucide:ellipsis" />
                    </twig:Button>
                </twig:DropdownMenu:Trigger>
                <twig:DropdownMenu:Content class="w-48">
                    <twig:DropdownMenu:Item>Edit configuration…</twig:DropdownMenu:Item>
                    <twig:DropdownMenu:Separator />
                    <twig:DropdownMenu:Item variant="destructive">Revoke agent…</twig:DropdownMenu:Item>
                </twig:DropdownMenu:Content>
            </twig:DropdownMenu>
            <twig:Button>
                <twig:ux:icon name="lucide:scan-search" />
                Scan now
            </twig:Button>
        </div>
    </div>

    <twig:MetaGrid :items="[
        {label: 'Hostname', value: 'web-01.example.net', mono: true},
        {label: 'Agent', value: 'depverify-agent 0.1.0', mono: true},
        {label: 'Mode', value: 'host · Docker enabled'},
        {label: 'System', value: 'Debian 13 · amd64'},
        {label: 'Kernel', value: '6.12.48-1', mono: true},
        {label: 'Fingerprint', value: 'SHA256:4f9c…a21e', mono: true},
    ]" />

    <twig:Tabs defaultValue="overview" class="gap-6">
        <twig:Tabs:List variant="line">
            <twig:Tabs:Trigger value="overview">Overview</twig:Tabs:Trigger>
            <twig:Tabs:Trigger value="findings">Findings</twig:Tabs:Trigger>
            <twig:Tabs:Trigger value="components">Components</twig:Tabs:Trigger>
            <twig:Tabs:Trigger value="apps">Applications</twig:Tabs:Trigger>
        </twig:Tabs:List>

        <twig:Tabs:Content value="overview">
            <div class="grid gap-6 lg:grid-cols-[1fr_18rem]">
                <section class="flex flex-col gap-6">
                    <div>
                        <h2 class="font-semibold">Agent</h2>
                        <p class="text-sm text-muted-foreground">Last inventory reported by the agent.</p>
                        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm md:grid-cols-4">
                            <div>
                                <dt class="text-muted-foreground">Status</dt>
                                <dd class="mt-1"><twig:StatusDot status="ok">Approved</twig:StatusDot></dd>
                            </div>
                            <div>
                                <dt class="text-muted-foreground">Last report</dt>
                                <dd class="mt-1">12 minutes ago</dd>
                            </div>
                            <div>
                                <dt class="text-muted-foreground">Next scan</dt>
                                <dd class="mt-1">in 5 h 48 min</dd>
                            </div>
                            <div>
                                <dt class="text-muted-foreground">OS packages</dt>
                                <dd class="mt-1">412</dd>
                            </div>
                        </dl>
                    </div>

                    <twig:Card>
                        <twig:Card:Header>
                            <twig:Card:Title>Open findings</twig:Card:Title>
                            <twig:Card:Description>Inherited by every project on this host.</twig:Card:Description>
                        </twig:Card:Header>
                        <twig:Card:Content>
                            <ul class="divide-y text-sm">
                                {% for f in [
                                    {severity: 'critical', id: 'CVE-2026-0001', pkg: 'pkg:deb/debian/openssl@3.5.1-1', kev: true},
                                    {severity: 'high', id: 'CVE-2026-0002', pkg: 'pkg:deb/debian/libxml2@2.12.7', kev: false},
                                    {severity: 'medium', id: 'EOL php 8.2', pkg: 'php-fpm 8.2.30 · security support ends 31/12/2026', kev: false},
                                ] %}
                                    <li class="flex items-center gap-3 py-2.5">
                                        <twig:SeverityBadge severity="{{ f.severity }}" />
                                        <span class="font-medium">{{ f.id }}</span>
                                        {% if f.kev %}<twig:Badge variant="destructive">KEV</twig:Badge>{% endif %}
                                        <span class="ms-auto truncate font-mono text-xs text-muted-foreground">{{ f.pkg }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </twig:Card:Content>
                    </twig:Card>
                </section>

                <aside class="flex flex-col gap-4 text-sm">
                    <div>
                        <h3 class="font-semibold">Projects</h3>
                        <ul class="mt-2 flex flex-col gap-1 text-muted-foreground">
                            <li>site-a · prod</li>
                            <li>api-b · prod</li>
                        </ul>
                    </div>
                    <twig:Separator />
                    <div>
                        <h3 class="font-semibold">Runtimes</h3>
                        <ul class="mt-2 flex flex-col gap-1 font-mono text-xs text-muted-foreground">
                            <li>php 8.2.30 (php8.2-fpm)</li>
                            <li>php 8.5.1 (php8.5-fpm)</li>
                            <li>node 24.11.0</li>
                        </ul>
                    </div>
                </aside>
            </div>
        </twig:Tabs:Content>
        <twig:Tabs:Content value="findings"><p class="text-sm text-muted-foreground">No content yet.</p></twig:Tabs:Content>
        <twig:Tabs:Content value="components"><p class="text-sm text-muted-foreground">No content yet.</p></twig:Tabs:Content>
        <twig:Tabs:Content value="apps"><p class="text-sm text-muted-foreground">No content yet.</p></twig:Tabs:Content>
    </twig:Tabs>
{% endblock %}
