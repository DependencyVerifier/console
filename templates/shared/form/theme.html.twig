{#- Form theme on the shadcn kit classes. Errors added by the application (refusals) are translation keys; constraint
    violations are already translated (validators domain). -#}
{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div data-slot="field" class="group/field flex w-full flex-col gap-2"{% if not valid %} data-invalid="true"{% endif %}{% for name, value in row_attr|filter((v, k) => k != 'class') %} {{ name }}="{{ value }}"{% endfor %}>
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" data-slot="field-description" class="text-xs leading-normal text-muted-foreground">
            {{- help|trans(help_translation_parameters, translation_domain) -}}
        </p>
    {%- endif -%}
{%- endblock form_help -%}

{#- A checkbox in the look of the kit's <twig:Checkbox> (input + check indicator). -#}
{%- block checkbox_widget -%}
    <span data-slot="checkbox" class="group relative mt-0.5 grid size-4 shrink-0 grid-cols-1">
        <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} class="peer col-start-1 row-start-1 size-4 appearance-none rounded-[4px] border border-input bg-transparent transition-colors outline-none checked:border-primary checked:bg-primary focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-input/30 dark:checked:bg-primary forced-colors:appearance-auto">
        <span data-slot="checkbox-indicator" class="pointer-events-none col-start-1 row-start-1 flex items-center justify-center text-primary-foreground opacity-0 group-has-checked:opacity-100">
            <twig:ux:icon name="lucide:check" class="size-3.5" />
        </span>
    </span>
{%- endblock checkbox_widget -%}

{#- A single checkbox: the box then its label on one line, help under it. -#}
{%- block checkbox_row -%}
    <div data-slot="field" class="group/field flex flex-col gap-1"{% if not valid %} data-invalid="true"{% endif %}>
        <label for="{{ id }}" class="flex w-fit cursor-pointer items-start gap-2 text-sm leading-snug font-medium select-none">
            {{- form_widget(form) -}}
            <span>{{ (label is empty ? name|humanize : label)|trans({}, translation_domain) }}</span>
        </label>
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{#- Several checkboxes (a multiple, expanded choice): one bordered list, a row per choice, the whole row clickable. -#}
{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="divide-y rounded-lg border">
        {%- for child in form %}
            <label for="{{ child.vars.id }}" class="flex cursor-pointer items-start gap-3 px-3 py-2.5 text-sm hover:bg-muted/50 has-disabled:cursor-not-allowed has-disabled:text-muted-foreground has-disabled:hover:bg-transparent">
                {{- form_widget(child) -}}
                <span>{{ child.vars.label|trans({}, child.vars.translation_domain) }}</span>
            </label>
        {%- endfor %}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block form_label -%}
    {%- if label is not same as(false) -%}
        <label for="{{ id }}" data-slot="field-label" class="flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none">
            {{- (label is empty ? name|humanize : label)|trans({}, translation_domain) -}}
        </label>
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' h-8 w-full min-w-0 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive md:text-sm dark:bg-input/30')|trim}) -%}
    {%- if not valid -%}{%- set attr = attr|merge({'aria-invalid': 'true'}) -%}{%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{#- A select in the look of the text inputs (form_widget_simple). -#}
{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' h-8 w-full min-w-0 rounded-lg border border-input bg-transparent px-2 py-1 text-base outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive md:text-sm dark:bg-input/30')|trim}) -%}
    {%- if not valid -%}{%- set attr = attr|merge({'aria-invalid': 'true'}) -%}{%- endif -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <div role="alert" data-slot="field-error" class="text-sm font-normal text-destructive">
            {%- for error in errors -%}
                <p>{{ error.cause is null ? error.message|trans : error.message }}</p>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block repeated_row -%}
    {{- form_row(form.first) -}}
    {{- form_row(form.second) -}}
    {{- form_errors(form) -}}
{%- endblock repeated_row -%}
