{% extends 'organization/project/_layout.html.twig' %}
{#- The page of an environment (variables: environment TeamEnvironment, summary, charts, criteria, tables.applications, tables.findings). -#}

{% block title %}{{ environment.name }} · {{ project.name }} · DependencyVerifier{% endblock %}

{% block tab %}
    <div class="flex items-center gap-2">
        <a href="{{ path('organization_project_environments', {teamId: project.teamId, projectId: project.id}) }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">{{ 'organization.project.tab.environments'|trans }}</a>
        <span aria-hidden="true" class="text-muted-foreground">›</span>
        <h2 class="text-lg font-semibold" data-environment>{{ environment.name }}</h2>
    </div>
    {{ include('exposure/_dashboard.html.twig', {teamId: project.teamId}) }}
    <twig:DataTable :table="tables.applications" :title="'inventory.applications.title'|trans" />
    <section class="flex flex-col gap-2" aria-labelledby="components-title">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <p id="components-title" class="text-sm text-muted-foreground">{{ 'inventory.matrix.description'|trans }}</p>
            <form method="get" data-controller="auto-submit" data-action="change->auto-submit#submit" class="flex items-center gap-2 text-sm">
                {%- for name, value in app.request.query.all|filter((v, k) => k != 'drift' and v is not iterable) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                <label class="flex items-center gap-2"><input type="checkbox" name="drift" value="1"{% if drift_only %} checked{% endif %} class="size-4"> {{ 'inventory.matrix.drift_only'|trans }}</label>
                <noscript><twig:Button type="submit" variant="outline" size="sm">{{ 'exposure.filters.apply'|trans }}</twig:Button></noscript>
            </form>
        </div>
        <twig:DataTable :table="tables.components" :title="'inventory.matrix.title'|trans" />
    </section>
    {{ include('exposure/_filters.html.twig') }}
    <twig:DataTable :table="tables.findings" :title="'exposure.findings.title'|trans" />
{% endblock %}
