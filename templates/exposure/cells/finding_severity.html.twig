{#- Severity of a vulnerability (with KEV and EPSS), level of an end of life, lag of an outdated dependency (row: FindingRow). -#}
<span class="flex flex-wrap items-center gap-1">
    {%- if row.kind == 'vulnerability' %}
        {%- if row.severity in ['critical', 'high', 'medium', 'low'] %}<twig:SeverityBadge severity="{{ row.severity }}" />{% else %}<span class="text-muted-foreground">—</span>{% endif %}
        {%- if row.cvss is not null %}<span class="font-mono text-xs tabular-nums">{{ row.cvss|number_format(1) }}</span>{% endif %}
        {%- if row.knownExploited %}<twig:Badge variant="destructive">{{ 'exposure.kev'|trans }}</twig:Badge>{% endif %}
        {%- if row.epss is not null %}<twig:Tooltip :text="'exposure.epss_help'|trans"><span class="rounded-sm text-xs text-muted-foreground tabular-nums underline decoration-dotted underline-offset-2 outline-hidden focus-visible:ring-2 focus-visible:ring-ring" tabindex="0">EPSS {{ (row.epss * 100)|number_format(1) }} %</span></twig:Tooltip>{% endif %}
    {%- elseif row.kind == 'eol' %}
        <twig:Badge variant="{{ row.eolLevel == 'expired' ? 'destructive' : 'outline' }}">{{ ('exposure.eol_level.' ~ row.eolLevel)|trans }}</twig:Badge>
        {%- if row.endOfLife %}<span class="text-xs text-muted-foreground tabular-nums">{{ row.endOfLife|date('Y-m-d') }}</span>{% endif %}
    {%- else %}
        <twig:Badge variant="outline">{{ ('exposure.lag.' ~ row.title)|trans }}</twig:Badge>
    {%- endif %}
</span>
