{#- The compact figures of a perimeter, in a lazy frame (team and project overviews, host page). Variables: summary,
    production (ProductionExposure, team overview only, else null), link (the Findings section, or null). -#}
<div class="flex flex-col gap-2">
    {%- if production %}{{ include('exposure/_production.html.twig') }}{% endif %}
    <dl class="grid grid-cols-2 overflow-hidden rounded-lg border bg-card sm:grid-cols-4 lg:grid-cols-6" data-dashboard="figures">
        {%- for severity in ['critical', 'high', 'medium', 'low'] %}
            <div class="-mb-px -me-px border-e border-b px-4 py-3" data-figure="{{ severity }}">
                <dt class="text-xs text-muted-foreground">{{ ('exposure.severity.' ~ severity)|trans }}</dt>
                <dd class="mt-1 text-xl font-semibold tabular-nums">{{ summary.severities[severity] ?? 0 }}</dd>
            </div>
        {%- endfor %}
        <div class="-mb-px -me-px border-e border-b px-4 py-3" data-figure="kev">
            <dt class="text-xs text-muted-foreground">{{ 'exposure.dashboard.known_exploited'|trans }}</dt>
            <dd class="mt-1 text-xl font-semibold tabular-nums">{{ summary.knownExploited }}</dd>
        </div>
        <div class="-mb-px -me-px border-e border-b px-4 py-3" data-figure="eol">
            <dt class="text-xs text-muted-foreground">{{ 'exposure.dashboard.ends_of_life'|trans }}</dt>
            <dd class="mt-1 text-xl font-semibold tabular-nums">{{ summary.endsOfLife }}</dd>
        </div>
    </dl>
    {%- if link %}<a href="{{ link }}" target="_top" class="self-start text-sm underline-offset-4 hover:underline">{{ 'exposure.dashboard.see_all'|trans }}</a>{% endif %}
</div>
