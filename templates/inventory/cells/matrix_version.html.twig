{#- A version of the matrix (row: MatrixRow), flagged when the component runs in several versions. -#}
<span class="flex items-center gap-2">
    <span class="font-mono text-xs">{{ row.version }}</span>
    {%- if row.drifts %}<twig:Tooltip :text="'inventory.matrix.drift_help'|trans({count: row.versions})"><twig:Badge variant="destructive" tabindex="0">{{ 'inventory.matrix.drift'|trans }}</twig:Badge></twig:Tooltip>{% endif -%}
</span>
