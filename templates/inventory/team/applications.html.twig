{% extends 'organization/team/_layout.html.twig' %}

{% block title %}{{ 'inventory.applications.title'|trans }} · {{ team.name }} · DependencyVerifier{% endblock %}

{% block tab %}
    <p class="text-sm text-muted-foreground">{{ 'inventory.applications.description'|trans }}</p>
    {%- if team.role != 'team_guest' %}
        <div id="unattached" class="scroll-mt-4"><twig:DataTable :table="tables.unattached" :title="'inventory.applications.to_attach'|trans" /></div>
    {%- endif %}
    <twig:DataTable :table="tables.applications" :title="'inventory.applications.attached_title'|trans" />
{% endblock %}
