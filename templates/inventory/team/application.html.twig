{% extends 'inventory/team/_object.html.twig' %}
{#- One application (variables: view ApplicationView, application AppRow, never `app`: the Twig global, tables.packages). -#}

{% block title %}{{ application.name }} · {{ team.name }} · DependencyVerifier{% endblock %}
{% block section_link %}<twig:Breadcrumb:Link href="{{ path('inventory_team_applications', {teamId: team.id}) }}">{{ 'inventory.applications.title'|trans }}</twig:Breadcrumb:Link>{% endblock %}
{% block object_title %}{{ application.name }}{% endblock %}
{% block object_subtitle %}
    <span>{{ ('inventory.kind.' ~ application.kind)|trans }}</span>
    <span aria-hidden="true">·</span>
    {{ include('inventory/cells/app_environment.html.twig', {row: application}) }}
{% endblock %}
{% block object_actions %}
    {%- if view.mayDetach %}
        <form method="post" action="{{ path('inventory_application_detach', {teamId: team.id, appId: application.id}) }}">
            <input type="hidden" name="action[_token]" value="{{ csrf_token('application_detach:' ~ application.id) }}">
            <twig:Button type="submit" variant="outline">{{ 'inventory.applications.detach'|trans }}</twig:Button>
        </form>
    {%- endif %}
    {%- if view.mayDocument %}
        <twig:FormDialog
            id="application-links"
            :title="'inventory.applications.links_title'|trans({name: application.name})"
            :description="'inventory.applications.links_description'|trans"
            :trigger="'inventory.applications.edit_links'|trans"
            variant="outline"
            :src="path('inventory_application_links', {teamId: team.id, appId: application.id})"
        />
    {%- endif %}
    {%- if view.assignable is empty and application.environmentId is null and (team.can('project.create') or team.can('project.environments.manage')) %}
        <p class="text-sm text-muted-foreground">{{ 'inventory.applications.no_environment'|trans }} <a href="{{ path('organization_team_projects', {teamId: team.id}) }}" class="font-medium text-foreground underline underline-offset-4">{{ 'inventory.applications.no_environment_link'|trans }}</a></p>
    {%- endif %}
    {%- if view.assignable is not empty %}
        <twig:FormDialog
            id="attach-application"
            :title="'inventory.applications.attach_title'|trans({name: application.name})"
            :description="'inventory.applications.attach_description'|trans"
            :trigger="(application.environmentId ? 'inventory.applications.move' : 'inventory.applications.attach')|trans"
            :src="path('inventory_application_attach', {teamId: team.id, appId: application.id})"
        />
    {%- endif %}
{% endblock %}

{% block object_facts %}
    {%- set runtime = application.fields.runtime ?? {} %}
    {%- set requires = application.requires %}
    {%- for name in ['php', 'node'] %}
        {%- set version = runtime.name is defined and runtime.name == name ? runtime.version : null %}
        {%- if version or requires[name] is defined %}
            <li><twig:Badge variant="secondary" class="font-mono">
                {{- ('inventory.facts.' ~ name)|trans }}{% if version %} {{ version }}{% endif %}
                {%- if requires[name] is defined %}<span class="text-muted-foreground">{{ 'inventory.facts.requires'|trans({constraint: requires[name]}) }}</span>{% endif -%}
            </twig:Badge></li>
        {%- endif %}
    {%- endfor %}
    {%- for framework in view.frameworks %}
        <li><twig:Badge variant="outline">{{ framework.label }}{% if framework.version %} {{ framework.version }}{% endif %}</twig:Badge></li>
    {%- endfor %}
    {%- if view.os %}
        <li><twig:Badge variant="outline">{{ view.os }}</twig:Badge></li>
    {%- endif %}
    <li><twig:Badge variant="outline">{{ 'inventory.facts.packages'|trans({count: application.packages}) }}</twig:Badge></li>
{% endblock %}

{% block tab %}
    <section class="rounded-lg border p-4">
        <dl class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <dt class="text-muted-foreground">{{ 'inventory.field.host'|trans }}</dt>
                <dd>{{ include('inventory/cells/app_host.html.twig', {row: application}) }}</dd>
            </div>
            {%- if application.runtime %}
                <div>
                    <dt class="text-muted-foreground">{{ 'inventory.field.runtime'|trans }}</dt>
                    <dd class="font-mono">{{ application.runtime }}{% if application.fields.runtime.service ?? null %} · {{ application.fields.runtime.service }}{% endif %}</dd>
                </div>
            {%- endif %}
            {%- if application.imageId %}
                <div>
                    <dt class="text-muted-foreground">{{ 'inventory.field.image'|trans }}</dt>
                    <dd>{% if view.imageRecordId %}<a href="{{ path('inventory_image', {teamId: team.id, imageId: view.imageRecordId}) }}" class="font-mono text-xs break-all underline-offset-4 hover:underline">{{ application.imageId }}</a>{% else %}<span class="font-mono text-xs break-all">{{ application.imageId }}</span>{% endif %}</dd>
                </div>
            {%- endif %}
            <div class="sm:col-span-2 lg:col-span-3">
                <dt class="text-muted-foreground">{{ 'inventory.field.subject'|trans }}</dt>
                <dd class="font-mono text-xs break-all">{{ application.subjectKey }}</dd>
            </div>
            <div>
                <dt class="text-muted-foreground">{{ 'inventory.field.last_seen'|trans }}</dt>
                <dd>{{ include('fleet/cells/time.html.twig', {value: application.lastSeenAt}) }}</dd>
            </div>
            <div class="sm:col-span-2 lg:col-span-3">
                <dt class="text-muted-foreground">{{ 'inventory.applications.links'|trans }}</dt>
                <dd>
                    {%- if application.links is empty %}<span class="text-muted-foreground">{{ 'inventory.applications.no_links'|trans }}</span>{% endif %}
                    <ul class="flex flex-col gap-1">
                        {%- for link in application.links %}
                            <li class="flex min-w-0 items-center gap-2">
                                <twig:ux:icon name="lucide:external-link" class="size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
                                <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer nofollow" class="truncate underline-offset-4 hover:underline">{{ link.label ?? link.url }}</a>
                                {%- if link.label %}<span class="truncate text-xs text-muted-foreground">{{ link.url }}</span>{% endif %}
                            </li>
                        {%- endfor %}
                    </ul>
                </dd>
            </div>
        </dl>
    </section>
    <twig:DataTable :table="tables.findings" :title="'exposure.findings.title'|trans">
        <twig:block name="actions">{{ include('exposure/_show_fixed.html.twig') }}</twig:block>
    </twig:DataTable>
    <twig:DataTable :table="tables.packages" :title="'inventory.packages.title'|trans({count: application.packages})" />
    <section class="flex flex-col gap-2">
        <twig:DataTable :table="tables.history" :title="'inventory.history.title'|trans" />
        <p class="text-xs text-muted-foreground">{{ 'inventory.history.retention'|trans }}</p>
    </section>
{% endblock %}
