<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}DependencyVerifier{% endblock %}</title>
        {# Logo and social card: docs/brand/ (favicon.svg, social/og-console.png). #}
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        <meta property="og:site_name" content="DependencyVerifier">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="Self-hosted monitoring of what really runs in production: hosts, runtimes and dependencies matched against OSV, CISA KEV, EPSS and endoflife.date.">
        <meta property="og:image" content="{{ absolute_url(asset('og-image.png')) }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
        {# Per-request CSP nonce: Turbo reads the first meta (progress bar style), Vite's dev client the second. #}
        <meta name="csp-nonce" content="{{ csp_nonce() }}">
        <meta property="csp-nonce" nonce="{{ csp_nonce() }}">
        {% block head_meta %}{% endblock %}
        {# Apply the theme before first paint (see assets/controllers/theme_controller.ts). #}
        <script nonce="{{ csp_nonce() }}">
            (() => {
                let pref = 'system';
                try { pref = localStorage.getItem('depverify-theme') ?? 'system'; } catch {}
                const dark = pref === 'dark' || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            })();
        </script>
        {% block stylesheets %}
            {{ reprise_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ reprise_entry_script_tags('app') }}
        {% endblock %}

    </head>
    <body class="min-h-svh bg-background text-foreground">
        {% block body %}{% endblock %}
    </body>
</html>
