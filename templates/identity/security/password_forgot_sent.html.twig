{% extends 'shared/layout/auth.html.twig' %}

{% block title %}{{ 'identity.password_forgot.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-4">
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'identity.password_forgot.sent_title'|trans }}</h1>
        <p class="text-sm text-muted-foreground">{{ 'identity.password_forgot.sent'|trans }}</p>
        <a href="{{ path('identity_login') }}" class="text-sm underline-offset-4 hover:underline">{{ 'identity.back_to_login'|trans }}</a>
    </div>
{% endblock %}
