{% extends 'shared/layout/auth.html.twig' %}

{% block title %}{{ 'identity.two_factor.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-balance">{{ 'identity.two_factor.title'|trans }}</h1>
            <p class="mt-1 text-sm text-muted-foreground">{{ (passkey ? 'identity.two_factor.passkey_description' : (email_code ? 'identity.two_factor.email_description' : 'identity.two_factor.totp_description'))|trans }}</p>
        </div>

        {% if error_key %}
            <twig:Alert variant="{{ error_key == 'identity.two_factor.code_resent' ? 'default' : 'destructive' }}">
                <twig:ux:icon name="lucide:info" />
                <twig:Alert:Description>{{ error_key|trans }}</twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        {% if passkey %}
        <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" class="flex flex-col gap-6" data-turbo="false"
              data-controller="passkey" data-passkey-options-value="{{ path('identity_two_factor_passkey_options') }}"
              data-passkey-csrf-value="{{ csrf_token(csrfTokenId) }}" data-passkey-mode-value="get" data-passkey-failed-message-value="{{ 'identity.passkey.failed'|trans }}" data-action="submit->passkey#start">
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            <input type="hidden" name="{{ authCodeParameterName }}" data-passkey-target="response">
            {% if displayTrustedOption %}
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="{{ trustedParameterName }}" value="1" class="size-4 rounded border-input">
                    {{ 'identity.two_factor.trust_device'|trans }}
                </label>
            {% endif %}
            <twig:Button type="submit" class="w-full"><twig:ux:icon name="lucide:key-round" /> {{ 'identity.two_factor.passkey'|trans }}</twig:Button>
            {#- Always present and empty: passkey_controller.ts changes its text, so the alert is announced. -#}
            <p class="text-sm text-destructive empty:hidden" role="alert" data-passkey-target="error"></p>
        </form>
        {% else %}
        <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" class="flex flex-col gap-6" data-turbo="false">
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            <twig:Field:Group>
                <twig:Field>
                    <twig:Field:Label for="auth-code">{{ 'identity.field.code'|trans }}</twig:Field:Label>
                    <twig:Input id="auth-code" type="text" name="{{ authCodeParameterName }}" autocomplete="one-time-code" inputmode="{{ email_code ? 'numeric' : 'text' }}" required autofocus />
                    {% if not email_code %}
                        <p class="text-sm text-muted-foreground">{{ 'identity.two_factor.backup_hint'|trans }}</p>
                    {% endif %}
                </twig:Field>
                {% if displayTrustedOption %}
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name="{{ trustedParameterName }}" value="1" class="size-4 rounded border-input">
                        {{ 'identity.two_factor.trust_device'|trans }}
                    </label>
                {% endif %}
                <twig:Button type="submit" class="w-full">{{ 'identity.two_factor.submit'|trans }}</twig:Button>
            </twig:Field:Group>
        </form>
        {% endif %}

        {% for other in availableTwoFactorProviders|filter(p => p != twoFactorProvider) %}
            <a href="{{ path('2fa_login', {preferProvider: other}) }}" class="text-center text-sm text-muted-foreground underline-offset-4 hover:underline">{{ ('identity.two_factor.use.' ~ other)|trans }}</a>
        {% endfor %}

        {% if email_code %}
            <form method="post" action="{{ path('identity_two_factor_resend') }}" data-turbo="false">
                <input type="hidden" name="action[_token]" value="{{ csrf_token('two_factor_resend') }}">
                <twig:Button type="submit" variant="link" class="w-full">{{ 'identity.two_factor.resend'|trans }}</twig:Button>
            </form>
        {% endif %}

        <form method="post" action="{{ logoutPath }}" data-turbo="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <twig:Button type="submit" variant="ghost" class="w-full">{{ 'identity.two_factor.cancel'|trans }}</twig:Button>
        </form>
    </div>
{% endblock %}
