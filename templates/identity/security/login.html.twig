{% extends 'shared/layout/auth.html.twig' %}

{% block title %}{{ 'identity.login.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-balance">{{ 'identity.login.title'|trans }}</h1>
            <p id="login-description" class="mt-1 text-sm text-muted-foreground">{{ 'identity.login.description'|trans }}</p>
        </div>

        {{ include('shared/_flashes.html.twig') }}
        {% if error_key %}
            <twig:Alert variant="destructive">
                <twig:ux:icon name="lucide:circle-alert" />
                <twig:Alert:Description>{{ error_key|trans }}</twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <form method="post" action="{{ path('identity_login') }}" class="flex flex-col gap-6" data-turbo="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <twig:Field:Group>
                <twig:Field>
                    <twig:Field:Label for="username">{{ 'identity.field.email'|trans }}</twig:Field:Label>
                    <twig:Input id="username" type="email" name="_username" value="{{ last_username }}" autocomplete="username webauthn" spellcheck="false" aria-describedby="login-description" required autofocus />
                </twig:Field>
                <twig:Field>
                    <div class="flex items-center">
                        <twig:Field:Label for="password">{{ 'identity.field.password'|trans }}</twig:Field:Label>
                        <a href="{{ path('identity_password_forgot') }}" class="ms-auto text-sm text-muted-foreground underline-offset-4 hover:underline">{{ 'identity.login.forgot'|trans }}</a>
                    </div>
                    <div class="relative" data-controller="password-visibility">
                        <twig:Input id="password" type="password" name="_password" autocomplete="current-password" class="pe-10" data-password-visibility-target="input" required />
                        <button type="button" aria-pressed="false" aria-label="{{ 'identity.field.show_password'|trans }}" data-action="password-visibility#toggle"
                                class="group/reveal absolute inset-y-0 end-0 inline-flex w-10 items-center justify-center rounded-e-lg text-muted-foreground outline-hidden hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring">
                            <twig:ux:icon name="lucide:eye" aria-hidden="true" class="size-4 group-aria-pressed/reveal:hidden" />
                            <twig:ux:icon name="lucide:eye-off" aria-hidden="true" class="hidden size-4 group-aria-pressed/reveal:block" />
                        </button>
                    </div>
                </twig:Field>
                <twig:Button type="submit" class="w-full">{{ 'identity.login.submit'|trans }}</twig:Button>
            </twig:Field:Group>
        </form>

        <form method="post" action="{{ path('identity_login_passkey') }}" class="flex flex-col gap-2" data-turbo="false"
              data-controller="passkey" data-passkey-options-value="{{ path('identity_login_passkey_options') }}"
              data-passkey-csrf-value="{{ csrf_token('passkey_login') }}" data-passkey-mode-value="get" data-passkey-conditional-value="true" data-passkey-failed-message-value="{{ 'identity.passkey.failed'|trans }}" data-passkey-duplicate-message-value="{{ 'identity.passkey.duplicate'|trans }}" data-action="submit->passkey#start">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('passkey_login') }}">
            <input type="hidden" name="_passkey" data-passkey-target="response">
            <twig:Button type="submit" variant="outline" class="w-full"><twig:ux:icon name="lucide:key-round" /> {{ 'identity.login.passkey'|trans }}</twig:Button>
            {#- Always present and empty: passkey_controller.ts changes its text, so the alert is announced. -#}
            <p class="text-sm text-destructive empty:hidden" role="alert" data-passkey-target="error"></p>
        </form>

        <p class="text-center text-xs text-muted-foreground">{{ 'identity.login.invitation_only'|trans }}</p>
    </div>
{% endblock %}
