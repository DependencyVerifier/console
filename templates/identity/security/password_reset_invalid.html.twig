{% extends 'shared/layout/auth.html.twig' %}

{% block title %}{{ 'identity.password_reset.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-4">
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'identity.password_reset.invalid_title'|trans }}</h1>
        <p class="text-sm text-muted-foreground">{{ 'identity.password_reset.invalid'|trans }}</p>
        <a href="{{ path('identity_password_forgot') }}" class="text-sm underline-offset-4 hover:underline">{{ 'identity.password_reset.ask_again'|trans }}</a>
    </div>
{% endblock %}
