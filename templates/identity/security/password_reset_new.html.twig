{% extends 'shared/layout/auth.html.twig' %}
{% form_theme form 'shared/form/theme.html.twig' %}

{% block title %}{{ 'identity.password_reset.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-balance">{{ 'identity.password_reset.title'|trans }}</h1>
        </div>
        {{ form_start(form, {attr: {class: 'flex flex-col gap-6', 'data-turbo': 'false', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {%- if account_email %}
                {#- The account the new password belongs to, for the password manager (autocomplete="username"); not submitted. -#}
                <div data-slot="field" class="flex w-full flex-col gap-2">
                    <label for="account-username" class="text-sm leading-snug font-medium">{{ 'identity.field.account'|trans }}</label>
                    <twig:Input id="account-username" type="email" value="{{ account_email }}" autocomplete="username" spellcheck="false" readonly />
                </div>
            {%- endif %}
            {{ form_row(form.password) }}
            <twig:Button type="submit" class="w-full">{{ 'identity.password_reset.submit'|trans }}</twig:Button>
        {{ form_end(form) }}
    </div>
{% endblock %}
