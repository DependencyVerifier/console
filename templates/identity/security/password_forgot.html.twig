{% extends 'shared/layout/auth.html.twig' %}
{% form_theme form 'shared/form/theme.html.twig' %}

{% block title %}{{ 'identity.password_forgot.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-balance">{{ 'identity.password_forgot.title'|trans }}</h1>
            <p class="mt-1 text-sm text-muted-foreground">{{ 'identity.password_forgot.description'|trans }}</p>
        </div>
        {{ form_start(form, {attr: {class: 'flex flex-col gap-6', 'data-turbo': 'false', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            <twig:Button type="submit" class="w-full">{{ 'identity.password_forgot.submit'|trans }}</twig:Button>
        {{ form_end(form) }}
        <a href="{{ path('identity_login') }}" class="text-center text-sm text-muted-foreground underline-offset-4 hover:underline">{{ 'identity.back_to_login'|trans }}</a>
    </div>
{% endblock %}
