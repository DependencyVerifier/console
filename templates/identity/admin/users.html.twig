{% extends 'shared/layout/app.html.twig' %}

{% block title %}{{ 'admin.users.title'|trans }} · DependencyVerifier{% endblock %}

{% block breadcrumb %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            <twig:Breadcrumb:Item>{{ 'admin.title'|trans }}</twig:Breadcrumb:Item>
            <twig:Breadcrumb:Separator />
            <twig:Breadcrumb:Item><twig:Breadcrumb:Page>{{ 'admin.users.title'|trans }}</twig:Breadcrumb:Page></twig:Breadcrumb:Item>
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endblock %}

{% block main %}
    {{ include('shared/_flashes.html.twig') }}
    <div id="action-alerts"></div>
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'admin.users.title'|trans }}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ 'admin.users.description'|trans }}</p>
    </div>
    {{ include('shared/frame/lazy.html.twig', {id: 'admin-users', src: path('identity_admin_users_frame'), rows: 6}) }}
{% endblock %}
