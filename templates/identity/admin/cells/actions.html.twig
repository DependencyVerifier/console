{%- import 'identity/admin/_actions.html.twig' as admin -%}
<div class="flex flex-wrap justify-end gap-1">
    {%- if row.deleted %}
    {{ admin.action('identity_admin_user_restore', 'restore', row, 'admin.users.restore', 'outline') }}
    {%- else %}
    {{ admin.action('identity_admin_user_reset_second_factor', 'reset_second_factor', row, 'admin.users.reset_second_factor', 'outline') }}
    {% if row.active %}
        {{ admin.action('identity_admin_user_deactivate', 'deactivate', row, 'admin.users.deactivate', 'destructive') }}
    {% else %}
        {{ admin.action('identity_admin_user_reactivate', 'reactivate', row, 'admin.users.reactivate', 'outline') }}
    {% endif %}
    {% if row.superAdmin %}
        {{ admin.action('identity_admin_user_revoke_super_admin', 'revoke_super_admin', row, 'admin.users.revoke_super_admin', 'ghost') }}
    {% else %}
        {{ admin.action('identity_admin_user_grant_super_admin', 'grant_super_admin', row, 'admin.users.grant_super_admin', 'ghost') }}
    {% endif %}
    {{ admin.action('identity_admin_user_delete', 'delete', row, 'admin.users.delete', 'destructive') }}
    {%- endif %}
</div>
