{% extends 'shared/layout/app.html.twig' %}
{% form_theme password_form 'shared/form/theme.html.twig' %}
{% form_theme totp_confirm_form 'shared/form/theme.html.twig' %}
{% form_theme passkey_form 'shared/form/theme.html.twig' %}

{% block title %}{{ 'identity.account.title'|trans }} · DependencyVerifier{% endblock %}

{% block breadcrumb %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            <twig:Breadcrumb:Item><twig:Breadcrumb:Page>{{ 'identity.account.title'|trans }}</twig:Breadcrumb:Page></twig:Breadcrumb:Item>
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endblock %}

{% block main %}
    {{ include('shared/_flashes.html.twig') }}
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-balance">{{ 'identity.account.title'|trans }}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ profile.email }}</p>
    </div>

    {% if profile.superAdmin and not profile.totpActive %}
        <twig:Alert>
            <twig:ux:icon name="lucide:shield-alert" />
            <twig:Alert:Title>{{ 'identity.account.totp_recommended.title'|trans }}</twig:Alert:Title>
            <twig:Alert:Description>{{ 'identity.account.totp_recommended.description'|trans }}</twig:Alert:Description>
        </twig:Alert>
    {% endif %}

    <div class="grid gap-6 lg:grid-cols-2">
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>{{ 'identity.account.password.title'|trans }}</twig:Card:Title>
                <twig:Card:Description>{{ 'identity.account.password.description'|trans }}</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ form_start(password_form, {action: path('identity_account_password'), attr: {class: 'flex flex-col gap-4', 'data-turbo': 'false', novalidate: 'novalidate'}}) }}
                    {#- The account the new password belongs to, for the password manager (autocomplete="username"); not submitted. -#}
                    <div data-slot="field" class="flex w-full flex-col gap-2">
                        <label for="account-username" class="text-sm leading-snug font-medium">{{ 'identity.field.account'|trans }}</label>
                        <twig:Input id="account-username" type="email" value="{{ profile.email }}" autocomplete="username" spellcheck="false" readonly />
                    </div>
                    {{ form_row(password_form.password) }}
                    <twig:Button type="submit">{{ 'identity.account.password.submit'|trans }}</twig:Button>
                {{ form_end(password_form) }}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>{{ 'identity.account.totp.title'|trans }}</twig:Card:Title>
                <twig:Card:Description>
                    {{ (profile.totpActive ? 'identity.account.totp.active' : 'identity.account.totp.inactive')|trans }}
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="flex flex-col gap-4">
                {% if profile.totpActive %}
                    <p class="text-sm">{{ 'identity.account.backup_codes.remaining'|trans({count: profile.remainingBackupCodes}) }}</p>
                    <div class="flex flex-wrap gap-2">
                        {{ form_start(backup_codes_form, {action: path('identity_account_backup_codes'), attr: {'data-turbo': 'false'}}) }}
                            <twig:Button type="submit" variant="outline">{{ 'identity.account.backup_codes.regenerate'|trans }}</twig:Button>
                        {{ form_end(backup_codes_form) }}
                        {{ form_start(totp_disable_form, {action: path('identity_account_totp_disable'), attr: {'data-turbo': 'false', 'data-controller': 'confirm', 'data-action': 'submit->confirm#ask', 'data-confirm-message-value': 'action.confirm'|trans({action: 'identity.account.totp.disable'|trans})}}) }}
                            <twig:Button type="submit" variant="destructive">{{ 'identity.account.totp.disable'|trans }}</twig:Button>
                        {{ form_end(totp_disable_form) }}
                    </div>
                {% elseif provisioning %}
                    <p class="text-sm">{{ 'identity.account.totp.scan'|trans }}</p>
                    <div class="w-60 rounded-lg bg-white p-2">{{ provisioning.qr|raw }}</div>
                    <p class="text-sm text-muted-foreground">{{ 'identity.account.totp.manual'|trans }}</p>
                    <code class="w-fit rounded bg-muted px-2 py-1 font-mono text-sm break-all">{{ provisioning.secret }}</code>
                    {{ form_start(totp_confirm_form, {action: path('identity_account_totp_confirm'), attr: {class: 'flex flex-col gap-4', 'data-turbo': 'false', novalidate: 'novalidate'}}) }}
                        {{ form_row(totp_confirm_form.code) }}
                        <twig:Button type="submit">{{ 'identity.account.totp.confirm'|trans }}</twig:Button>
                    {{ form_end(totp_confirm_form) }}
                {% else %}
                    {{ form_start(totp_start_form, {action: path('identity_account_totp_start'), attr: {'data-turbo': 'false'}}) }}
                        <twig:Button type="submit">{{ 'identity.account.totp.start'|trans }}</twig:Button>
                    {{ form_end(totp_start_form) }}
                {% endif %}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card class="lg:col-span-2">
            <twig:Card:Header>
                <twig:Card:Title>{{ 'identity.account.passkeys.title'|trans }}</twig:Card:Title>
                <twig:Card:Description>{{ 'identity.account.passkeys.description'|trans }}</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="flex flex-col gap-4">
                {%- if passkey_signal %}
                    <div hidden data-controller="passkey-signal" data-passkey-signal-rp-id-value="{{ passkey_signal.rpId }}" data-passkey-signal-user-id-value="{{ passkey_signal.userId }}" data-passkey-signal-credential-ids-value="{{ passkey_signal.credentialIds|json_encode }}"></div>
                {%- endif %}
                {% if profile.passkeys is empty %}
                    <p class="text-sm text-muted-foreground">{{ 'identity.account.passkeys.none'|trans }}</p>
                {% else %}
                    <ul class="divide-y rounded-md border">
                        {% for passkey in profile.passkeys %}
                            <li class="flex flex-wrap items-center justify-between gap-2 px-3 py-2">
                                <div>
                                    <p class="text-sm font-medium">{{ passkey.name }}</p>
                                    <p class="text-xs text-muted-foreground">{{ 'identity.account.passkeys.dates'|trans({created: passkey.createdAt|date('Y-m-d'), used: passkey.lastUsedAt ? passkey.lastUsedAt|date('Y-m-d H:i') : '—'}) }}</p>
                                </div>
                                {{ form_start(passkey_revoke_forms[passkey.id], {action: path('identity_account_passkey_revoke', {passkeyId: passkey.id}), attr: {'data-turbo': 'false', 'data-controller': 'confirm', 'data-action': 'submit->confirm#ask', 'data-confirm-message-value': 'action.confirm'|trans({action: 'identity.account.passkeys.revoke_named'|trans({name: passkey.name})})}}) }}
                                    <twig:Button type="submit" variant="destructive" size="sm" aria-label="{{ 'identity.account.passkeys.revoke_named'|trans({name: passkey.name}) }}">{{ 'identity.account.passkeys.revoke'|trans }}</twig:Button>
                                {{ form_end(passkey_revoke_forms[passkey.id]) }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if profile.passkeys|length < max_passkeys %}
                    {{ form_start(passkey_form, {action: path('identity_account_passkey_register'), attr: {class: 'flex flex-col gap-4', 'data-turbo': 'false', novalidate: 'novalidate',
                        'data-controller': 'passkey', 'data-passkey-options-value': path('identity_account_passkey_options'), 'data-passkey-csrf-value': csrf_token('passkey_register'),
                        'data-passkey-mode-value': 'create', 'data-passkey-failed-message-value': 'identity.passkey.failed'|trans,
                        'data-passkey-duplicate-message-value': 'identity.passkey.duplicate'|trans, 'data-action': 'submit->passkey#start'}}) }}
                        {{ form_row(passkey_form.name) }}
                        {{ form_widget(passkey_form.response) }}
                        {#- Always present and empty: passkey_controller.ts changes its text, so the alert is announced. -#}
                        <p class="text-sm text-destructive empty:hidden" role="alert" data-passkey-target="error"></p>
                        <twig:Button type="submit" class="w-fit"><twig:ux:icon name="lucide:key-round" /> {{ 'identity.account.passkeys.add'|trans }}</twig:Button>
                    {{ form_end(passkey_form) }}
                {% endif %}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
