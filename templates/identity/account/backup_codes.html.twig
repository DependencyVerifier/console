{#- Shown once, in the response of the POST itself (never cached, never through the session). -#}
{% extends 'shared/layout/app.html.twig' %}

{% block title %}{{ 'identity.account.backup_codes.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex max-w-xl flex-col gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">{{ 'identity.account.backup_codes.title'|trans }}</h1>
            <p class="mt-1 text-sm text-muted-foreground">{{ (first_enrollment ? 'identity.account.totp.enabled' : 'identity.account.backup_codes.regenerated')|trans }}</p>
        </div>
        <twig:Alert>
            <twig:ux:icon name="lucide:triangle-alert" />
            <twig:Alert:Description>{{ 'identity.account.backup_codes.once'|trans }}</twig:Alert:Description>
        </twig:Alert>
        <ul class="grid grid-cols-2 gap-2 font-mono text-sm" data-testid="backup-codes">
            {% for code in codes %}<li class="rounded bg-muted px-2 py-1">{{ code }}</li>{% endfor %}
        </ul>
        <p class="text-sm text-muted-foreground">{{ 'identity.account.backup_codes.signed_out'|trans }}</p>
        <twig:Button as="a" href="{{ path('identity_login') }}" class="w-fit">{{ 'identity.back_to_login'|trans }}</twig:Button>
    </div>
{% endblock %}
