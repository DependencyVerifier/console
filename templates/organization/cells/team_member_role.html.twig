{#- The role as a badge (it changes from the row menu), then the extra permissions granted on top. -#}
<span class="inline-flex flex-wrap items-center gap-1">
    <twig:Badge variant="secondary">{{ ('role.' ~ row.role)|trans }}</twig:Badge>
    {%- for extra in row.extras %}<twig:Badge variant="outline" class="font-mono">{{ extra }}</twig:Badge>{% endfor -%}
</span>
