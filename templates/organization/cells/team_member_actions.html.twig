{%- import 'organization/_actions.html.twig' as ui -%}
{%- set team_id = app.request.attributes.get('teamId') -%}
<div class="flex flex-wrap justify-end gap-1">
    {#- A TEAM_ADMIN holds every team permission: nothing to grant on top. -#}
    {%- if row.role != 'team_admin' %}
        <twig:FormDialog
            id="member-permissions-{{ row.userId }}"
            :title="'organization.permissions.title'|trans({email: row.email})"
            :description="'organization.permissions.description'|trans"
            :trigger="'organization.permissions.open'|trans"
            :src="path('organization_team_member_extra', {teamId: team_id, userId: row.userId})"
            variant="outline"
            size="xs"
        />
    {%- endif %}
    {{ ui.button(path('organization_team_member_remove', {teamId: team_id, userId: row.userId}), 'team_member_remove:' ~ row.userId, 'organization.members.remove', 'destructive') }}
</div>
