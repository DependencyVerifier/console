{%- import 'shared/_row_menu.html.twig' as menu -%}
{%- set team_id = app.request.attributes.get('teamId') -%}
{%- set project_id = app.request.attributes.get('projectId') -%}
{%- set dialog_id = 'member-permissions-' ~ row.userId -%}
<div class="flex justify-end">
    <twig:FormDialog
        id="{{ dialog_id }}"
        :title="'organization.permissions.title'|trans({email: row.email})"
        :description="'organization.permissions.description_project'|trans"
        :trigger="'organization.permissions.open'|trans"
        :src="path('organization_project_member_extra', {teamId: team_id, projectId: project_id, userId: row.userId})"
        :hiddenTrigger="true"
    />
    <twig:DropdownMenu id="member-{{ row.userId }}" side="bottom" align="end" class="inline-block text-start">
        <twig:DropdownMenu:Trigger>
            <twig:Button variant="ghost" size="icon-sm" :aria-label="'organization.members.actions_for'|trans({email: row.email})" :title="'organization.members.actions_for'|trans({email: row.email})" {{ ...dropdown_menu_trigger_attrs }}><twig:ux:icon name="lucide:ellipsis" /></twig:Button>
        </twig:DropdownMenu:Trigger>
        <twig:DropdownMenu:Content class="w-max min-w-44">
            {%- import 'shared/_row_menu.html.twig' as menu -%}
        {{ menu.role(path('organization_project_member_role', {teamId: team_id, projectId: project_id, userId: row.userId}), 'project_member_role:' ~ row.userId, ['project_admin', 'project_member', 'project_viewer'], row.role) }}
        {{ menu.dialog(dialog_id, 'organization.permissions.open', 'lucide:key-round') }}
        <twig:DropdownMenu:Separator />
        {{ menu.action(path('organization_project_member_remove', {teamId: team_id, projectId: project_id, userId: row.userId}), 'action', 'project_member_remove:' ~ row.userId, 'organization.members.remove', 'destructive') }}
        </twig:DropdownMenu:Content>
    </twig:DropdownMenu>
</div>
