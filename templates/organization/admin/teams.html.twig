{% extends 'shared/layout/app.html.twig' %}

{% block title %}{{ 'organization.teams.title'|trans }} · DependencyVerifier{% endblock %}

{% block breadcrumb %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            <twig:Breadcrumb:Item>{{ 'admin.title'|trans }}</twig:Breadcrumb:Item>
            <twig:Breadcrumb:Separator />
            <twig:Breadcrumb:Item><twig:Breadcrumb:Page>{{ 'organization.teams.title'|trans }}</twig:Breadcrumb:Page></twig:Breadcrumb:Item>
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endblock %}

{% block main %}
    {{ include('shared/_flashes.html.twig') }}
    <div id="action-alerts"></div>
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-balance">{{ 'organization.teams.title'|trans }}</h1>
            <p class="mt-1 text-sm text-muted-foreground">{{ 'organization.teams.description'|trans }}</p>
        </div>
        <div class="flex shrink-0 gap-2">
            <twig:Button as="a" variant="outline" href="{{ path('organization_admin_default_quotas') }}">{{ 'organization.quotas.defaults'|trans }}</twig:Button>
            <twig:FormDialog
                id="create-team"
                :title="'organization.teams.new'|trans"
                :description="'organization.teams.new_description'|trans"
                :trigger="'organization.teams.new'|trans"
                :src="path('organization_admin_team_create')"
            />
        </div>
    </div>
    <twig:DataTable :table="table" :title="'organization.teams.title'|trans" />
{% endblock %}
