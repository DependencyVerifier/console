{% extends 'organization/team/_layout.html.twig' %}
{% form_theme rename_form 'shared/form/theme.html.twig' %}

{% block tab %}
    <div class="grid max-w-3xl gap-6">
        <section class="grid gap-4 rounded-lg border p-4 sm:grid-cols-[12rem_minmax(0,1fr)]" aria-labelledby="team-name-title">
            <div>
                <h2 id="team-name-title" class="text-sm font-semibold">{{ 'organization.team.name_title'|trans }}</h2>
                <p class="mt-1 text-xs text-muted-foreground">{{ 'organization.team.name_help'|trans }}</p>
            </div>
            {{ form_start(rename_form, {action: path('organization_team_rename', {teamId: team.id}), attr: {class: 'flex flex-wrap items-end gap-2', novalidate: 'novalidate'}}) }}
                <div class="min-w-48 flex-1">{{ form_row(rename_form.name, {label: false, attr: {'aria-labelledby': 'team-name-title'}}) }}</div>
                <twig:Button type="submit" variant="outline">{{ 'organization.team.rename'|trans }}</twig:Button>
            {{ form_end(rename_form) }}
        </section>

        <section class="grid gap-4 rounded-lg border p-4 sm:grid-cols-[12rem_minmax(0,1fr)]" aria-labelledby="team-identity-title">
            <h2 id="team-identity-title" class="text-sm font-semibold">{{ 'organization.team.identity_title'|trans }}</h2>
            <dl class="grid gap-3 text-sm">
                <div>
                    <dt class="text-xs text-muted-foreground">{{ 'organization.team.facts.slug'|trans }}</dt>
                    <dd class="mt-0.5 font-mono">{{ team.slug }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-muted-foreground">{{ 'organization.team.facts.id'|trans }}</dt>
                    <dd class="mt-0.5 font-mono break-all">{{ team.id }}</dd>
                </div>
            </dl>
        </section>
    </div>
{% endblock %}
