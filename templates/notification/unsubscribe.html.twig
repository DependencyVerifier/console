{#- Unsubscribe link of a notification email: GET asks, POST turns the subscription off (no login, signed URL). -#}
{% extends 'shared/layout/auth.html.twig' %}

{% block title %}{{ 'notification.unsubscribe.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-4">
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'notification.unsubscribe.title'|trans }}</h1>
        {% if done %}
            <p class="text-sm text-muted-foreground">{{ 'notification.unsubscribe.done'|trans }}</p>
        {% else %}
            <p class="text-sm text-muted-foreground">{{ 'notification.unsubscribe.ask'|trans }}</p>
            <form method="post" action="{{ action }}">
                <twig:Button type="submit" class="w-fit">{{ 'notification.unsubscribe.confirm'|trans }}</twig:Button>
            </form>
        {% endif %}
    </div>
{% endblock %}
