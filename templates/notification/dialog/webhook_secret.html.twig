{#- Shown once, in the response of the POST (SecretRevealingResponse): the signing secret of a webhook. Variables:
    frame_id, secret, message. -#}
<turbo-frame id="{{ frame_id }}">
    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-4 text-sm">
        <twig:Alert variant="default">
            <twig:ux:icon name="lucide:key-round" />
            <twig:Alert:Title>{{ 'notification.webhooks.shown_once'|trans }}</twig:Alert:Title>
            <twig:Alert:Description>{{ 'notification.webhooks.shown_once_description'|trans }}</twig:Alert:Description>
        </twig:Alert>
        <div>
            <p class="mb-1 text-muted-foreground">{{ 'notification.webhooks.secret'|trans }}</p>
            <code class="block rounded-md border bg-muted px-3 py-2 font-mono text-sm break-all select-all">{{ secret }}</code>
        </div>
        <p class="text-muted-foreground">{{ 'notification.webhooks.signature_help'|trans }}</p>
        <footer class="flex justify-end">
            <twig:Button type="button" data-action="dialog#close">{{ 'notification.webhooks.done'|trans }}</twig:Button>
        </footer>
    </div>
    <turbo-stream action="update" target="action-alerts">
        <template>
            <twig:Alert>
                <twig:ux:icon name="lucide:circle-check" />
                <twig:Alert:Description>{{ message|trans }}</twig:Alert:Description>
            </twig:Alert>
        </template>
    </turbo-stream>
</turbo-frame>
