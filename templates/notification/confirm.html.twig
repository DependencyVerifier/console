{#- Confirmation link of a notification recipient: GET asks, POST confirms (no login, the token authorizes). -#}
{% extends 'shared/layout/auth.html.twig' %}

{% block title %}{{ 'notification.confirm.title'|trans }} · DependencyVerifier{% endblock %}

{% block main %}
    <div class="flex flex-col gap-4">
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'notification.confirm.title'|trans }}</h1>
        {% if state == 'done' %}
            <p class="text-sm text-muted-foreground">{{ 'notification.confirm.done'|trans }}</p>
        {% elseif state == 'invalid' %}
            <p class="text-sm text-muted-foreground">{{ 'notification.confirm.invalid'|trans }}</p>
        {% else %}
            <p class="text-sm text-muted-foreground">{{ 'notification.confirm.ask'|trans }}</p>
            <form method="post">
                <twig:Button type="submit" class="w-fit">{{ 'notification.confirm.confirm'|trans }}</twig:Button>
            </form>
        {% endif %}
    </div>
{% endblock %}
