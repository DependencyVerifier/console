# Credentials of the owner role (migrations, audit partition maintenance), copied to owner.env (git-ignored).
# Never loaded by symfony/runtime: the Makefile reads this file on the host and passes the variable to CLI
# commands only (docker compose exec -e DATABASE_MIGRATIONS_URL). Change the password outside development.
DATABASE_MIGRATIONS_URL=postgresql://depverify_owner:!ChangeMeOwner!@database:5432/app?serverVersion=18&charset=utf8
