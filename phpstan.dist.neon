includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    # Green field: maximum level, no baseline. Keep it that way.
    level: max
    paths:
        - src
        - tests
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: var/cache/dev/Shared_KernelDevDebugContainer.xml
    ignoreErrors:
        # Integration tests reach ports through test-only public aliases (config/services_test.yaml), which the dev
        # container analysed by phpstan-symfony does not hold.
        -
            identifier: symfonyContainer.serviceNotFound
            path: tests/*
