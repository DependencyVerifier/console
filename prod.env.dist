# Production settings of the console (INSTALL.md). bin/install-console copies this file to prod.env (git-ignored,
# mode 600): fill SERVER_NAME, DEFAULT_URI, MAILER_DSN and MAILER_FROM, the script generates the secrets left empty
# and never replaces a value already set. Manual commands need it loaded first: set -a; . ./prod.env; set +a
# Keep a copy of this file somewhere safe: without APP_ENCRYPTION_KEYS the stored secrets (webhooks, TOTP) are lost,
# and without APP_AGENT_SIGNING_KEY every agent must be installed again.

COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The public address of the console (Caddy gets its Let's Encrypt certificate for it).
SERVER_NAME=console.example.com
DEFAULT_URI=https://console.example.com

# openssl rand -hex 32
APP_SECRET=
# "kid=base64(32 random bytes)", e.g. key1=$(openssl rand -base64 32); the first key is current (rotation: prepend).
APP_ENCRYPTION_KEYS=
APP_HASH_PEPPER=
# openssl rand -base64 32: the console key every agent pins. Never replace it directly (cadrage decision 79).
APP_AGENT_SIGNING_KEY=

# TLS is mandatory (smtps://… or STARTTLS): the mailbox is a second factor.
MAILER_DSN=
MAILER_FROM=

# PostgreSQL: the superuser, then the two application roles (runtime, owner). openssl rand -hex 24 for each.
POSTGRES_PASSWORD=
DEPVERIFY_APP_PASSWORD=
DEPVERIFY_OWNER_PASSWORD=

# Optional: reverse proxies in front of Caddy (IPs or CIDRs), audit retention in days.
SYMFONY_TRUSTED_PROXIES=
AUDIT_RETENTION_DAYS=365
